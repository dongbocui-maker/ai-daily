    classDef skill fill:#08161a,stroke:#34d399,stroke-width:1.5px,color:#5ee6a8
    classDef loopn fill:#160a1a,stroke:#c98bff,stroke-width:1.5px,color:#d9a8ff
    classDef done fill:#0a1a12,stroke:#34d399,stroke-width:1.5px,color:#5ee6a8
    classDef esc fill:#1a0a0c,stroke:#ff5a6a,stroke-width:1.5px,color:#ff8a96
    classDef startn fill:#071824,stroke:#00E5FF,stroke-width:2px,color:#7fefff
    classDef dec fill:#0d1119,stroke:#7a9cb8,color:#aeb9c8

    class MK2,MAIN,PUB,OK1,MK46,FIXQC agent
    class JASON1,ESC1,ESC2 human
    class NBLM skill
    class RETRY loopn
    class END1,END2 done
    class Start startn
    class V,BR,CHK dec

    linkStyle default stroke:#3a6a8a,stroke-width:1.5px

    style QC fill:#070f16,stroke:#28384f,color:#8b96a8
