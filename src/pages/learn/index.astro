---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SectionSprite from '../../components/SectionSprite.astro';
import learnData from '../../data/learn.json';
import '../../styles/sections.css';

const base = import.meta.env.BASE_URL;

// 学习板块条目——从 src/data/learn.json 读取。
// 新增课程只需改 JSON，不动源码。说明见 docs/learn-template.md。
const items = learnData.items.map((it) => ({
  href: it.external ? it.href : `${base.replace(/\/$/, '')}${it.href}`,
  tag: it.tag,
  title: it.title,
  desc: it.desc,
  meta: it.meta,
  external: it.external ?? false,
}));

const total = items.length;
---
<Base title="研修院" description="AI 相关的学习计划、课程笔记、技术资料汇总。">
  <Header />
  <SectionSprite />
  <main class="sec-page" style="--acc:#EC4899;--acc-deep:#BE185D;--acc-ghost:#FDEEF5;--acc-band:#FEF7FB">
    <section class="hero"><div class="wrap">
      <span class="badge"><svg class="ic"><use href="#i-grad"/></svg>Academy</span>
      <h1>研修<span class="pu">院</span></h1>
      <p class="hero-sub">系统化的 AI 工程学习材料：最佳实践、方法论长文与团队案例。独立于每日资讯主题，聚焦深度学习与长期价值，持续扩充。</p>
      <div class="stats">
        {total > 0 && <div class="stat"><b>{total}</b><span>已上线专题</span></div>}
        <div class="stat"><b>不<i>定期</i></b><span>更新节奏</span></div>
      </div>
    </div></section>

    <div class="wrap">
      <div class="sec-head">
        <span class="sq"><svg class="ic"><use href="#i-grad"/></svg></span>
        <div class="tt"><span class="eyebrow">Topics</span><h2>全部专题</h2></div>
        <span class="rule"></span><span class="cnt">{total} 个</span>
      </div>

      {total === 0 ? (
        <div class="empty"><p>暂无学习内容。</p></div>
      ) : (
        <div class="cards">
          {items.map((it) => (
            <a class="card" href={it.href}
              target={it.external ? '_blank' : undefined}
              rel={it.external ? 'noopener noreferrer' : undefined}>
              <div class="meta">
                <span class="pill">{it.tag}</span>
              </div>
              <h3>{it.title}</h3>
              <p>{it.desc}</p>
              <div class="acts">
                <span>{it.external ? '前往学习' : '开始学习'} →</span>
                {it.meta && it.meta.length > 0 && (
                  <span class="dim">{it.meta.join(' · ')}</span>
                )}
              </div>
            </a>
          ))}
        </div>
      )}

      <p class="note" style="text-align:center;margin:40px 0 8px">更多学习内容陆续添加中。</p>
    </div>
  </main>
  <Footer />
</Base>
