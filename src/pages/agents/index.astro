---
// S.H.R.I.M.P. OS · Agents Monitor — Iron Man HUD 风格独立监控页
// 数据双源：
//   主源 LIVE_URL = data.aidigest.club（Cloudflare Tunnel → VM 实时端点，每60s聚合，近实时）
//   兜底 FALLBACK_URL = 打包进站点的静态 JSON（tunnel 挂了时不白屏）
const BASE = import.meta.env.BASE_URL;
const LIVE_URL = 'https://data.aidigest.club/dashboard.json';
const FALLBACK_URL = `${BASE}agents/data/dashboard-fallback.json`;
---
<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="robots" content="noindex,nofollow" />
<title>S.H.R.I.M.P. OS · Agents Monitor</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700;900&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet" />
<style is:global>
:root{
  --red:#E62429; --red-dim:#7a1418; --gold:#FFC400; --gold-dim:#8a6a00;
  --arc:#3FC9FF; --arc-glow:#00E5FF; --bg:#070A0F; --panel:#0E1118; --panel2:#141927;
  --line:#1f2a3d; --txt:#cdd6e3; --dim:#6b7689;
}
*{margin:0;padding:0;box-sizing:border-box}
body{
  background:var(--bg); color:var(--txt); font-family:'JetBrains Mono',monospace;
  background-image:
    radial-gradient(circle at 15% 10%, rgba(230,36,41,.10), transparent 40%),
    radial-gradient(circle at 85% 90%, rgba(63,201,255,.08), transparent 45%),
    repeating-linear-gradient(0deg, rgba(255,255,255,.012) 0 1px, transparent 1px 3px);
  min-height:100vh; padding:24px; letter-spacing:.3px;
}
.scan{position:fixed;inset:0;pointer-events:none;background:repeating-linear-gradient(0deg,rgba(63,201,255,.025) 0 2px,transparent 2px 5px);z-index:99;animation:scan 8s linear infinite}
@keyframes scan{to{background-position:0 100px}}
.hud-corner{position:fixed;width:40px;height:40px;border-color:var(--gold);opacity:.5;z-index:50}
.tl{top:12px;left:12px;border-top:2px solid;border-left:2px solid}
.tr{top:12px;right:12px;border-top:2px solid;border-right:2px solid}
.bl{bottom:12px;left:12px;border-bottom:2px solid;border-left:2px solid}
.br{bottom:12px;right:12px;border-bottom:2px solid;border-right:2px solid}

header{display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid var(--line);padding-bottom:16px;margin-bottom:24px;flex-wrap:wrap;gap:12px}
.logo{font-family:'Orbitron';font-weight:900;font-size:26px;color:var(--gold);text-shadow:0 0 16px rgba(255,196,0,.4)}
.logo .red{color:var(--red);text-shadow:0 0 16px rgba(230,36,41,.5)}
.logo small{display:block;font-family:'JetBrains Mono';font-size:10px;color:var(--dim);letter-spacing:3px;margin-top:2px}
.jarvis{text-align:right;font-size:11px;color:var(--arc)}
.jarvis .pulse{color:var(--arc-glow);text-shadow:0 0 10px var(--arc-glow);animation:blink 2s infinite}
@keyframes blink{50%{opacity:.4}}
.jarvis .ts{color:var(--dim);font-size:10px}

.summary{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-bottom:24px}
.stat{background:linear-gradient(135deg,var(--panel),var(--panel2));border:1px solid var(--line);border-radius:6px;padding:16px 18px;position:relative;overflow:hidden}
.stat::before{content:'';position:absolute;top:0;left:0;width:3px;height:100%;background:var(--red)}
.stat.g::before{background:var(--gold)} .stat.a::before{background:var(--arc)}
.stat .k{font-size:10px;color:var(--dim);letter-spacing:2px;text-transform:uppercase}
.stat .v{font-family:'Orbitron';font-weight:700;font-size:24px;margin-top:8px;color:#fff}
.stat .v .u{font-size:13px;color:var(--dim);font-family:'JetBrains Mono'}
.stat.g .v{color:var(--gold)} .stat.a .v{color:var(--arc)}
.stat .sub{font-size:10px;color:var(--dim);margin-top:4px}

h2.sec{font-family:'Orbitron';font-weight:700;font-size:14px;color:var(--gold);letter-spacing:3px;margin:8px 0 16px;display:flex;align-items:center;gap:10px}
h2.sec::after{content:'';flex:1;height:1px;background:linear-gradient(90deg,var(--gold-dim),transparent)}

.suits{display:grid;grid-template-columns:repeat(2,1fr);gap:16px;margin-bottom:28px}
.suit{background:linear-gradient(135deg,var(--panel),#0c1420);border:1px solid var(--line);border-radius:8px;padding:18px;position:relative;overflow:hidden}
.suit::before{content:'';position:absolute;top:50%;right:-20px;transform:translateY(-50%);width:200px;height:200px;background:url('/agents/ironman-lineart.png') no-repeat center right/contain;opacity:.14;pointer-events:none;z-index:0}
.suit.online::before{opacity:.20}
.suit.idle::before{opacity:.13}
.suit.offline::before{opacity:.09}
.suit-head,.suit-grid{position:relative;z-index:1}
.suit.online{border-color:rgba(63,201,255,.4);box-shadow:0 0 24px rgba(63,201,255,.08)}
.suit.idle{border-color:rgba(255,196,0,.25)}
.suit.offline{opacity:.62}
.suit-head{display:flex;align-items:center;gap:14px;margin-bottom:14px}
.reactor{width:46px;height:46px;border-radius:50%;flex-shrink:0;display:flex;align-items:center;justify-content:center;position:relative;overflow:visible;background:#05080c;border:2px solid #1d3a4a;transition:.45s}
.reactor svg{width:44px;height:44px;display:block}
.reactor.online{border-color:var(--ac,var(--arc));box-shadow:0 0 16px var(--glow),inset 0 0 7px var(--glow)}
.reactor.idle{border-color:#3a4a52}
.reactor.offline{border-color:#1a2228;background:#05070a}
@keyframes glowSteady{0%,100%{opacity:.92}50%{opacity:1}}
@keyframes breathe{0%,100%{opacity:.12}45%,55%{opacity:1}}
@keyframes spin{to{transform:rotate(360deg)}}
.reactor.online .core{animation:glowSteady 2.6s ease-in-out infinite}
.reactor.idle .core{animation:breathe 1.8s ease-in-out infinite}
.reactor.offline .core{opacity:.05!important}
.reactor.online .ring-rot{animation:spin 14s linear infinite;transform-origin:50px 50px}
.reactor.idle .ring-rot{animation:spin 26s linear infinite;transform-origin:50px 50px}
.reactor.offline .metal{stroke:#2a3138!important}
.suit-id .mark{font-family:'Orbitron';font-weight:700;font-size:13px;color:var(--gold);letter-spacing:1px}
.suit-id .nm{font-size:16px;color:#fff;font-weight:700;margin-top:2px}
.suit-id .role{font-size:9px;color:var(--dim);letter-spacing:2px;margin-top:2px}
.badge{margin-left:auto;font-size:10px;font-weight:700;padding:4px 10px;border-radius:3px;letter-spacing:1px}
.badge.online{background:rgba(63,201,255,.15);color:var(--arc);border:1px solid var(--arc)}
.badge.idle{background:rgba(255,196,0,.12);color:var(--gold);border:1px solid var(--gold-dim)}
.badge.offline{background:rgba(230,36,41,.12);color:var(--red);border:1px solid var(--red-dim)}
.suit-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px 18px;font-size:11px}
.cell .lbl{color:var(--dim);font-size:9px;letter-spacing:1px;text-transform:uppercase}
.cell .val{font-family:'Orbitron';font-size:15px;color:#fff;margin-top:2px}
.cell .val.gold{color:var(--gold)} .cell .val.arc{color:var(--arc)}
.pwr{grid-column:1/-1;margin-top:6px}
.pwr .bar{height:8px;background:#0a0e16;border:1px solid var(--line);border-radius:4px;overflow:hidden;margin-top:4px;position:relative}
.pwr .fill{height:100%;background:linear-gradient(90deg,var(--red),var(--gold));box-shadow:0 0 10px rgba(255,196,0,.5)}
.models-mini{grid-column:1/-1;margin-top:10px;font-size:10px;color:var(--dim);border-top:1px dashed var(--line);padding-top:8px}
.models-mini span{color:var(--arc)}

/* 顶部行：CAPABILITY MATRIX | FALLBACK SYSTEMS 并排，桌面双列、手机单列竖排 */
.toprow{display:grid;grid-template-columns:1fr 1fr;gap:24px;align-items:stretch;margin-bottom:28px}
.panel{background:var(--panel);border:1px solid var(--line);border-radius:8px;padding:18px}
table{width:100%;border-collapse:collapse;font-size:11px}
th{text-align:left;color:var(--gold);font-size:9px;letter-spacing:1px;border-bottom:1px solid var(--line);padding:6px 8px;text-transform:uppercase}
td{padding:7px 8px;border-bottom:1px solid rgba(31,42,61,.5)}
td.r{text-align:right;font-family:'Orbitron'}
.mdl{color:#fff}
.chain{font-size:12px;line-height:2.2}
.chain .node{display:inline-block;padding:3px 10px;border-radius:3px;margin:2px 0}
.chain .primary{background:rgba(255,196,0,.12);border:1px solid var(--gold);color:var(--gold)}
.chain .fb{background:rgba(230,36,41,.08);border:1px solid var(--red-dim);color:#d88}
.chain .arr{color:var(--dim);margin:0 6px}
.chain .agent-row{margin-bottom:14px}
.chain .who{font-size:11px;color:var(--arc);letter-spacing:1px;display:block;margin-bottom:4px}
footer{margin-top:28px;text-align:center;font-size:10px;color:var(--dim);border-top:1px solid var(--line);padding-top:16px;letter-spacing:1px}
footer .red{color:var(--red-dim)}
.loading{text-align:center;padding:80px 20px;color:var(--arc);font-size:14px;letter-spacing:2px}
.loading .pulse{animation:blink 1.2s infinite}

/* Login Gate v5: v1 base + fixed equilateral inverted triangle reactor */
body.gate-locked{padding:0;display:grid;place-items:center;overflow:hidden;background:radial-gradient(circle at 50% 38%,rgba(63,201,255,.16),transparent 32%),radial-gradient(circle at 50% 58%,rgba(255,196,0,.08),transparent 38%),linear-gradient(180deg,#020307,#070a0f 54%,#030508)}
body.gate-locked header,body.gate-locked footer,body.gate-locked .event-ticker{display:none}

/* === Event Ticker 跑马灯 === */
.event-ticker{position:relative;height:36px;background:linear-gradient(90deg,rgba(7,10,15,.95),rgba(14,17,24,.95));border:1px solid var(--line);border-radius:5px;margin-bottom:24px;overflow:hidden;display:flex;align-items:center}
.event-ticker::before{content:"◈ SIGNAL";font-family:'Orbitron';font-size:10px;color:var(--gold);letter-spacing:2px;padding:0 14px;white-space:nowrap;flex-shrink:0;background:linear-gradient(90deg,rgba(7,10,15,.98) 60%,transparent);z-index:2;line-height:36px;text-shadow:0 0 8px rgba(255,196,0,.5)}
.event-track{flex:1;overflow:hidden;position:relative;height:100%;display:flex;align-items:center}
.event-stream{display:flex;gap:0;white-space:nowrap;position:absolute;left:0;animation:eventScroll var(--scroll-dur,40s) linear infinite}
.event-stream:hover{animation-play-state:paused}
.event-item{display:inline-flex;align-items:center;padding:0 32px;height:36px;font-size:11px;letter-spacing:.4px;position:relative}
.event-item::after{content:"⦁";position:absolute;right:4px;top:50%;transform:translateY(-50%);color:var(--dim);font-size:8px}
.event-item .ev-tag{font-family:'Orbitron';font-size:8px;letter-spacing:1.5px;padding:2px 6px;border-radius:2px;margin-right:8px;flex-shrink:0;font-weight:700}
.event-item .ev-tag.qc{background:rgba(63,201,255,.15);color:var(--arc);border:1px solid rgba(63,201,255,.3)}
.event-item .ev-tag.deploy{background:rgba(255,196,0,.12);color:var(--gold);border:1px solid rgba(255,196,0,.3)}
.event-item .ev-tag.fallback{background:rgba(230,36,41,.12);color:var(--red);border:1px solid rgba(230,36,41,.3)}
.event-item .ev-tag.alert{background:rgba(230,36,41,.18);color:var(--red);border:1px solid var(--red);animation:pulseTag 1.5s ease-in-out infinite}
.event-item .ev-time{color:var(--dim);margin-right:8px;font-size:10px;flex-shrink:0}
.event-item .ev-msg{color:#cdd6e3}
@keyframes eventScroll{0%{transform:translateX(0)}100%{transform:translateX(var(--scroll-end))}}
@keyframes pulseTag{50%{opacity:.6}}
body.gate-locked #app{width:100%;min-height:100vh;display:grid;place-items:center;padding:18px}
.login-gate{position:relative;width:min(460px,calc(100vw - 36px));padding:34px 34px 30px;background:linear-gradient(180deg,rgba(16,23,36,.92),rgba(7,12,18,.94));border:1px solid rgba(63,201,255,.34);border-radius:18px;box-shadow:0 0 0 1px rgba(255,196,0,.08) inset,0 0 48px rgba(0,229,255,.13),0 24px 80px rgba(0,0,0,.65)}
.login-gate:before,.login-gate:after{content:"";position:absolute;width:44px;height:44px;border-color:var(--gold);opacity:.75}.login-gate:before{left:-1px;top:-1px;border-left:2px solid;border-top:2px solid;border-radius:18px 0 0 0}.login-gate:after{right:-1px;bottom:-1px;border-right:2px solid;border-bottom:2px solid;border-radius:0 0 18px 0}
.login-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:24px}.login-brand{font-family:'Orbitron';font-weight:900;letter-spacing:2.8px;color:var(--gold);font-size:19px;text-shadow:0 0 18px rgba(255,196,0,.45)}.login-private-badge{font-size:10px;letter-spacing:2px;color:var(--arc);border:1px solid rgba(63,201,255,.45);padding:5px 8px;border-radius:999px;background:rgba(63,201,255,.08)}
.login-reactor{width:128px;height:128px;margin:4px auto 22px;position:relative;display:grid;place-items:center;border-radius:50%;filter:drop-shadow(0 0 22px rgba(0,229,255,.35))}.login-reactor svg{width:128px;height:128px}.login-rotor{animation:spin 18s linear infinite;transform-origin:50px 50px}.login-tri{animation:loginTriPulse 2.1s ease-in-out infinite}@keyframes loginTriPulse{50%{filter:drop-shadow(0 0 16px var(--arc-glow));opacity:.86}}
.login-title{text-align:center;font-family:'Orbitron';font-weight:800;letter-spacing:3px;font-size:22px;margin-bottom:8px;color:#fff}.login-subtitle{text-align:center;color:var(--dim);font-size:11px;line-height:1.7;letter-spacing:1.5px;text-transform:uppercase;margin-bottom:26px}.login-terminal{border:1px solid rgba(63,201,255,.22);background:#05080d;border-radius:10px;padding:13px 14px;margin-bottom:16px;color:#8edfff;font-size:11px;line-height:1.75;box-shadow:inset 0 0 18px rgba(63,201,255,.04)}.login-terminal b{color:var(--gold);font-weight:700}.login-cursor{display:inline-block;width:7px;height:13px;background:var(--arc);vertical-align:-2px;animation:blink 1s steps(1) infinite}
.login-form{display:grid;gap:12px}.login-pin-wrap{display:flex;gap:8px;align-items:center;background:#060a10;border:1px solid #1b3a4c;border-radius:10px;padding:12px 14px;transition:.25s}.login-pin-wrap:focus-within{border-color:var(--arc);box-shadow:0 0 0 2px rgba(63,201,255,.12),0 0 20px rgba(63,201,255,.16)}.login-prompt{font-family:'Orbitron';color:var(--gold);font-size:13px;letter-spacing:1px}.login-input{flex:1;background:transparent;border:0;outline:0;color:#fff;font-family:'JetBrains Mono';font-size:20px;letter-spacing:7px;text-align:left;min-width:0}.login-btn{height:46px;border:0;border-radius:10px;cursor:pointer;background:linear-gradient(90deg,var(--arc),#7fdfff);color:#031018;font-family:'Orbitron';font-weight:900;letter-spacing:2px;font-size:13px;box-shadow:0 0 20px rgba(63,201,255,.25);transition:.2s}.login-btn:hover{transform:translateY(-1px);box-shadow:0 0 28px rgba(63,201,255,.38)}.login-meta{display:flex;justify-content:space-between;color:#7a9cb8;font-size:10px;letter-spacing:1px;margin-top:16px;text-transform:uppercase}.login-err{height:16px;text-align:center;color:#ff8080;font-size:11px;margin-top:12px;letter-spacing:1px}

/* 响应式：电脑双列保持设计图布局，手机自适应单列竖排（保留 HUD 风格） */
@media(max-width:768px){
  body{padding:14px}
  .logo{font-size:20px}
  .summary{grid-template-columns:1fr;gap:12px;margin-bottom:18px}
  .stat .v{font-size:22px}
  .suits{grid-template-columns:1fr;gap:14px;margin-bottom:22px}
  .toprow{grid-template-columns:1fr;gap:18px;margin-bottom:22px}
  .suit-grid{grid-template-columns:1fr 1fr} /* 战甲卡内部 2 列保留，紧凑 */
  .hud-corner{width:24px;height:24px}
  .trend-chart{height:120px;gap:6px}
  .tbar{max-width:none}
  table{font-size:11px}
  .bd-tip{min-width:150px}
}
@media(max-width:420px){
  .suit-grid{grid-template-columns:1fr 1fr}
  .stat .v{font-size:20px}
  .trend-head{font-size:10px}
  .bd-tip{min-width:135px;font-size:10px}
}
/* 近7天趋势图 */
.trend-sec{background:var(--panel);border:1px solid var(--line);border-radius:8px;padding:16px 20px 12px;margin-bottom:22px;position:relative;overflow:visible}
.trend-sec::before{content:'';position:absolute;top:0;left:0;width:3px;height:100%;background:linear-gradient(var(--arc),var(--gold))}
.trend-head{font-family:'Orbitron';font-size:12px;letter-spacing:2px;color:var(--arc);margin-bottom:14px;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:6px}
.trend-sum{font-size:11px;color:var(--gold);letter-spacing:1px;font-family:'JetBrains Mono'}
.trend-chart{display:flex;align-items:flex-end;gap:10px;height:130px;padding-top:18px;position:relative}
/* SVG 曲线叠加层：JS 用 chart 像素尺寸作 viewBox + 真实柱顶坐标绘制，100% 对齐 */
.trend-curve{position:absolute;left:0;top:0;width:100%;height:100%;pointer-events:none;z-index:3;overflow:visible}
.trend-curve .tline{fill:none;stroke:var(--gold);stroke-width:2;opacity:.9;filter:drop-shadow(0 0 4px rgba(255,196,0,.6))}
.tdot{fill:var(--arc);stroke:#0a0e14;stroke-width:2}
.tdot.today{fill:var(--gold)}
.tbar-wrap{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;height:100%;gap:4px;position:relative;z-index:2}
.tbar-val{font-size:10px;color:var(--dim);font-family:'JetBrains Mono'}
.tbar{width:100%;max-width:60px;background:linear-gradient(180deg,var(--arc),rgba(63,201,255,.25));border-radius:3px 3px 0 0;border:1px solid var(--arc);border-bottom:none;transition:height .4s,box-shadow .2s;min-height:4px;box-shadow:0 0 10px rgba(63,201,255,.3);cursor:pointer}
.tbar.today{background:linear-gradient(180deg,var(--gold),rgba(255,196,0,.3));border-color:var(--gold);box-shadow:0 0 14px rgba(255,196,0,.5)}
.tbar-wrap:hover .tbar{box-shadow:0 0 18px rgba(63,201,255,.8);filter:brightness(1.3)}
.tbar-day{font-size:10px;color:var(--dim);font-family:'JetBrains Mono';letter-spacing:.5px}
/* breakdown tooltip */
.bd-tip{position:absolute;bottom:calc(100% + 8px);left:50%;transform:translateX(-50%) translateY(6px);background:#0a0e14;border:1px solid var(--arc);border-radius:6px;padding:8px 10px;min-width:180px;opacity:0;visibility:hidden;transition:opacity .18s,transform .18s;z-index:20;box-shadow:0 4px 20px rgba(0,0,0,.7),0 0 14px rgba(63,201,255,.25);pointer-events:none}
.tbar-wrap:hover .bd-tip{opacity:1;visibility:visible;transform:translateX(-50%) translateY(0)}
.bd-tip::after{content:'';position:absolute;top:100%;left:50%;transform:translateX(-50%);border:6px solid transparent;border-top-color:var(--arc)}
.bd-date{font-family:'Orbitron';font-size:10px;color:var(--gold);letter-spacing:1px;margin-bottom:6px;padding-bottom:5px;border-bottom:1px solid var(--line)}
.bd-row{display:flex;justify-content:space-between;gap:8px;font-size:11px;font-family:'JetBrains Mono';padding:2px 0;white-space:nowrap}
.bd-n{color:var(--txt)}.bd-t{color:var(--arc)}.bd-c{color:var(--gold);min-width:48px;text-align:right}
.bd-tot{margin-top:6px;padding-top:5px;border-top:1px solid var(--line);font-size:10px;color:var(--dim);font-family:'JetBrains Mono';text-align:right}
/* ===== CAPABILITY MATRIX ===== */
.capcard{background:linear-gradient(135deg,var(--panel),#0c1420);border:1px solid var(--line);border-radius:8px;padding:18px 20px;position:relative;overflow:hidden;box-shadow:0 0 24px rgba(63,201,255,.05);width:100%}
.capcard::before{content:'';position:absolute;top:-30px;right:-30px;width:220px;height:220px;background:radial-gradient(circle,rgba(63,201,255,.10),transparent 70%);pointer-events:none}
.cap-head{display:flex;align-items:center;gap:12px;border-bottom:1px solid var(--line);padding-bottom:13px;margin-bottom:6px;flex-wrap:wrap}
.cap-head .cic{width:9px;height:9px;background:var(--arc);box-shadow:0 0 12px var(--arc-glow);transform:rotate(45deg);flex-shrink:0}
/* CAPABILITY MATRIX 标题与 FALLBACK SYSTEMS 等 .sec 标题保持一致（金色 Orbitron），去掉 .sec 默认外边距以与右侧 stat 同行 */
.cap-head .cap-sec{margin:0}
.cap-title{font-family:'Orbitron';font-weight:800;letter-spacing:2px;font-size:15px;color:#fff}
.cap-stat{margin-left:auto;display:flex;gap:11px;font-size:9px;color:var(--dim);letter-spacing:.5px}
.cap-stat b{font-family:'Orbitron';font-size:12px;margin-right:4px}
.cap-stat .ca b{color:var(--arc)} .cap-stat .cg b{color:var(--gold)}
.cap-list{margin-top:8px}
.cap-row{display:flex;align-items:center;gap:10px;width:100%;background:transparent;border:none;border-bottom:1px solid #141c28;color:var(--txt);font-family:inherit;padding:11px 4px;cursor:pointer;text-align:left;transition:.12s}
.cap-row:last-child{border-bottom:none}
.cap-row:hover{background:rgba(63,201,255,.05)}
.cr-name{font-family:'Orbitron';font-size:11px;letter-spacing:.5px;color:#e6edf6;width:128px;flex-shrink:0}
.cr-bar{display:flex;gap:5px;flex:1;align-items:center}
.cr-bar i{width:10px;height:10px;transform:skewX(-22deg);flex-shrink:0;transition:.12s;border-radius:1px}
.cr-bar i.on{background:var(--arc);box-shadow:0 0 6px rgba(63,201,255,.65)}
.cr-bar i.off{background:transparent;border:1px solid #1d2838}
.cap-row:hover .cr-bar i.on{box-shadow:0 0 9px rgba(63,201,255,.9)}
.cr-num{font-family:'Orbitron';font-size:18px;color:var(--gold);width:32px;text-align:right;flex-shrink:0;text-shadow:0 0 10px rgba(255,196,0,.35)}
.cr-ws{font-size:12px;color:var(--arc);width:42px;text-align:right;flex-shrink:0}
.cr-ws small{font-size:8px;color:var(--dim);margin-left:2px}
.cr-st{width:7px;height:7px;border-radius:50%;background:#39d98a;box-shadow:0 0 8px #39d98a;flex-shrink:0}
.cr-arrow{color:var(--dim);font-size:10px;flex-shrink:0}
.cap-row:hover .cr-arrow{color:var(--arc)}
.cap-legend{border-top:1px solid var(--line);margin-top:12px;padding-top:12px;color:var(--dim);font-size:9.5px;letter-spacing:.5px;line-height:1.7}
.cap-legend b{color:var(--arc)}
.cap-legend .ld{display:inline-block;width:8px;height:7px;background:var(--arc);transform:skewX(-22deg);vertical-align:middle;margin:0 3px}
.cap-legend .ldot{display:inline-block;width:7px;height:7px;border-radius:50%;background:#39d98a;vertical-align:middle;margin:0 3px;box-shadow:0 0 6px #39d98a}
.cap-ov{position:fixed;inset:0;background:rgba(3,6,10,.72);backdrop-filter:blur(3px);display:none;z-index:50}
.cap-ov.on{display:block}
.cap-pop{display:none;position:fixed;top:7vh;left:50%;transform:translateX(-50%);width:min(820px,92vw);max-height:84vh;overflow:auto;background:#0b0f17;border:1px solid #28384f;border-radius:12px;padding:20px;z-index:51;box-shadow:0 20px 60px rgba(0,0,0,.6)}
.cap-pop.on{display:block}
.cp-head{display:flex;justify-content:space-between;align-items:center;font-family:'Orbitron';font-size:14px;color:var(--gold);border-bottom:1px solid var(--line);padding-bottom:11px;margin-bottom:15px}
.cp-x{background:none;border:1px solid var(--line);color:var(--dim);border-radius:6px;padding:5px 10px;font-family:inherit;font-size:10px;cursor:pointer}
.cp-x:hover{color:var(--arc);border-color:var(--arc)}
.cp-sec{font-size:10px;letter-spacing:2px;color:var(--arc);margin-bottom:10px}
.cp-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:8px}
.csk{display:flex;align-items:center;gap:10px;background:#0d1119;border:1px solid var(--line);border-radius:7px;padding:9px 11px}
.csk-ico{font-size:15px;width:20px;text-align:center;flex-shrink:0}
.csk-body{flex:1;min-width:0} .csk-name{font-size:12px;color:#e6edf6;font-weight:600}
.csk-desc{font-size:9px;color:var(--dim);margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.csk-src{display:flex;gap:3px;flex-shrink:0;flex-wrap:wrap;justify-content:flex-end;max-width:90px}
.csk-atag{font-size:8px;color:var(--arc);border:1px solid #224;border-radius:4px;padding:1px 5px;background:rgba(63,201,255,.07)}
.csk-shared{font-size:8px;color:var(--gold);border:1px solid var(--gold-dim);border-radius:4px;padding:1px 5px;background:rgba(255,196,0,.06)}
.csk-empty{color:var(--dim);font-size:11px;padding:6px}
.cap-fold{margin-top:15px;border-top:1px dashed var(--line);padding-top:11px}
.cap-foldbtn{background:none;border:none;color:var(--dim);font-family:inherit;font-size:10px;letter-spacing:1px;cursor:pointer;padding:0}
.cap-foldbtn:hover{color:var(--gold)}
.cap-foldbody{display:none;margin-top:11px;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:8px}
.cap-fold.open .cap-foldbody{display:grid}
@media(max-width:768px){.cr-name{width:120px;font-size:11px}.cr-bar i{width:9px;height:9px}.cap-stat{gap:10px}}
/* ===== AGENT TOPOLOGY · 调度架构 ===== */
.arch-card{position:relative;background:linear-gradient(135deg,var(--panel),#0a1018);border:1px solid var(--line);border-radius:8px;padding:18px 22px 22px;margin-bottom:22px;overflow:hidden;box-shadow:0 0 30px rgba(63,201,255,.06)}
.arch-card::before{content:'';position:absolute;top:-40px;left:50%;transform:translateX(-50%);width:480px;height:240px;background:radial-gradient(circle,rgba(63,201,255,.10),transparent 68%);pointer-events:none}
.arch-head{display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line);padding-bottom:12px;margin-bottom:4px;position:relative;z-index:2;flex-wrap:wrap;gap:8px}
.arch-title{font-family:'Orbitron';font-weight:800;font-size:14px;color:var(--gold);letter-spacing:3px}
.arch-legend{display:flex;gap:16px;font-size:9.5px;color:var(--dim);letter-spacing:.5px;flex-wrap:wrap}
.alg{display:flex;align-items:center;gap:6px}
.alg .aln{width:22px;height:0;border-top:2px solid}
.alg .aln.solid{border-top-style:solid;border-color:var(--arc-glow);box-shadow:0 0 6px var(--arc-glow)}
.alg .aln.dot{border-top-style:dotted;border-top-width:3px;border-color:#48b4ec}
.alg .adot{width:8px;height:8px;border-radius:50%;background:#39d98a;box-shadow:0 0 6px #39d98a}
.arch-topo{position:relative;z-index:2;padding:22px 8px 6px}
.arch-lines{position:absolute;inset:0;width:100%;height:100%;pointer-events:none;z-index:1;overflow:visible}
.arch-tier{position:relative;z-index:2;display:flex;justify-content:center;gap:54px}
.arch-tier.t1{margin-bottom:78px}
.arch-node{position:relative;width:196px;background:linear-gradient(160deg,#0d1422,#0a0f18);border:1px solid var(--line);border-radius:10px;padding:15px 16px 14px;transition:.18s}
.arch-node:hover{transform:translateY(-2px)}
.arch-node.orch{border-color:rgba(255,196,0,.35);box-shadow:0 0 22px rgba(255,196,0,.10)}
.arch-node.worker{border-color:rgba(63,201,255,.28);box-shadow:0 0 18px rgba(63,201,255,.08)}
.arch-mark{font-family:'Orbitron';font-weight:700;font-size:13px;letter-spacing:1.5px}
.arch-nm{font-size:14px;color:#fff;font-weight:600;margin-top:5px;letter-spacing:.5px}
.arch-role{font-size:9px;letter-spacing:1.5px;color:var(--dim);text-transform:uppercase;border-top:1px dashed var(--line);padding-top:9px;margin-top:10px;display:flex;align-items:flex-start;justify-content:space-between;gap:8px}
.arch-rlabel{line-height:1.45}
.arch-st{display:flex;align-items:center;gap:5px;font-size:8px;flex-shrink:0;padding-top:1px}
.arch-stdot{width:6px;height:6px;border-radius:50%;flex-shrink:0}
.arch-stdot.on{background:#39d98a;box-shadow:0 0 6px #39d98a}
.arch-stdot.off{background:#555f70}
.arch-direct{position:absolute;top:-9px;right:12px;font-size:7.5px;letter-spacing:1px;font-family:'Orbitron';color:var(--arc);background:#08111c;border:1px solid rgba(63,201,255,.45);border-radius:999px;padding:2px 8px;box-shadow:0 0 8px rgba(63,201,255,.25)}
.arch-mini{display:none}
/* 窄屏/手机 ≤768px：保持上下两层结构，节点改紧凑徽章，调度链变细（不隐藏） */
@media(max-width:768px){
  .arch-card{padding:16px 14px 22px}
  .arch-topo{padding:18px 4px 4px}
  .arch-tier{gap:18px}
  .arch-tier.t1{gap:40px;margin-bottom:62px}
  .arch-tier.t2{gap:14px}
  .arch-full{display:none}
  /* 节点变紧凑徽章卡 */
  .arch-node{width:auto;flex:0 0 auto;padding:11px 6px 9px;border-radius:12px;text-align:center}
  .arch-node:hover{transform:none}
  .arch-node.orch{box-shadow:0 0 18px rgba(255,196,0,.12)}
  .arch-node.worker{box-shadow:0 0 16px rgba(63,201,255,.10)}
  .arch-mini{display:block;width:74px;position:relative}
  .mb-code{font-family:'Orbitron';font-weight:800;font-size:19px;letter-spacing:.5px;line-height:1}
  .mb-role{font-size:7px;letter-spacing:.6px;color:var(--dim);text-transform:uppercase;margin-top:6px;line-height:1.3}
  .mb-nm{font-size:9px;color:#aeb9c8;margin-top:3px;letter-spacing:.2px}
  .mb-st{position:absolute;top:-2px;right:0;width:6px;height:6px;border-radius:50%}
  .mb-st.on{background:#39d98a;box-shadow:0 0 6px #39d98a}
  .mb-st.off{background:#555f70}
  /* 窄屏 DIRECT 移到徽章底部居中 */
  .arch-direct{top:auto;bottom:-8px;right:50%;transform:translateX(50%);font-size:6.5px;padding:1px 6px}
}
</style>
</head>
<body>
<div class="scan"></div>
<div class="hud-corner tl"></div><div class="hud-corner tr"></div>
<div class="hud-corner bl"></div><div class="hud-corner br"></div>

<header>
  <div class="logo"><span class="red">S.H.R.I.M.P.</span> OS
    <small>SHRIMP HYPERVISOR · RESOURCE &amp; INTELLIGENCE MONITORING PLATFORM</small>
  </div>
  <div class="jarvis">
    <div class="pulse" id="suitsMonitored">◉ J.A.R.V.I.S. ONLINE · SUITS MONITORED</div>
    <div class="ts" id="ts"></div>
  </div>
</header>

<div class="event-ticker" id="ticker">
  <div class="event-track"><div class="event-stream" id="tickerStream"></div></div>
</div>

<div id="app"><div class="loading"><span class="pulse">◉ BOOTING REACTOR · LOADING TELEMETRY...</span></div></div>

<footer>
  ⌜ S.H.R.I.M.P. OS v0.1 ⌟ · DATA SNAPSHOT <span id="gen">—</span> ·
  <span class="red">CONFIDENTIAL</span> · POWERED BY 🦐 IRON SHRIMP STACK
</footer>

<script define:vars={{ LIVE_URL, FALLBACK_URL }}>
const CHAINS={
  main:['fable-5','opus-4.8','gpt-5.5','qwen3.7-max'],
  aima:['fable-5','opus-4.8','gpt-5.5','qwen3.7-max'],
  mk2:['fable-5','opus-4.8','gpt-5.5','qwen3.7-max'],
  mk46:['qwen3.7-max','opus-4.8','gpt-5.5'],
  'claude-researcher':['opus-4.8','gpt-5.5','qwen3.7-max'],
};
const CHAIN_MODEL_KEYS={
  'opus-4.8':'aigw-claude-48-main/claude-opus-4-8',
  'fable-5':'aigw-claude-48-main/claude-fable-5',
  'gpt-5.5':'azure-openai-responses/gpt-5.5',
  'qwen3.7-max':'qwen/qwen3.7-max',
  'sonnet-4.6':'anthropic/claude-sonnet-4-6',
};
const CARD_NAME_OVERRIDES={
  main:'钢铁虾 统帅',
  aima:'银月 副翎',
  mk2:'MK2 工程师',
  mk46:'MK46 校官',
};
const chainModelKey = n => CHAIN_MODEL_KEYS[n] || n;
const fmt = n => n.toLocaleString('en-US');
const fmtTok = n => n>=1e9?(n/1e9).toFixed(2)+'B':n>=1e6?(n/1e6).toFixed(1)+'M':fmt(n);

// 钢铁侠方舟反应堆 SVG：外金属大环 + 24齿刻度环 + 8段旋转线圈 + 内发光圆盘 + 中心三角核 + 中心白光点
function reactorSvg(ac,lit,id){
  let coils='';
  for(let k=0;k<8;k++){const a=k*45*Math.PI/180;coils+='<line x1="'+(50+Math.cos(a)*22).toFixed(1)+'" y1="'+(50+Math.sin(a)*22).toFixed(1)+'" x2="'+(50+Math.cos(a)*30).toFixed(1)+'" y2="'+(50+Math.sin(a)*30).toFixed(1)+'" stroke="'+lit+'" stroke-width="3" stroke-linecap="round"/>';}
  let ticks='';
  for(let k=0;k<24;k++){const a=k*15*Math.PI/180;ticks+='<line x1="'+(50+Math.cos(a)*33).toFixed(1)+'" y1="'+(50+Math.sin(a)*33).toFixed(1)+'" x2="'+(50+Math.cos(a)*37).toFixed(1)+'" y2="'+(50+Math.sin(a)*37).toFixed(1)+'" stroke="'+ac+'" stroke-width="1.2"/>';}
  return '<svg viewBox="0 0 100 100"><defs><radialGradient id="g'+id+'" cx="50%" cy="50%" r="50%"><stop offset="0%" stop-color="#fff"/><stop offset="28%" stop-color="'+lit+'"/><stop offset="70%" stop-color="'+lit+'" stop-opacity=".25"/><stop offset="100%" stop-color="'+lit+'" stop-opacity="0"/></radialGradient></defs><circle class="metal" cx="50" cy="50" r="40" fill="#070c11" stroke="'+ac+'" stroke-width="3"/><g class="metal">'+ticks+'</g><circle class="metal" cx="50" cy="50" r="33" fill="none" stroke="'+ac+'" stroke-width="1.5" opacity=".7"/><g class="core ring-rot">'+coils+'</g><circle class="core" cx="50" cy="50" r="21" fill="url(#g'+id+')"/><circle class="metal" cx="50" cy="50" r="21" fill="none" stroke="'+ac+'" stroke-width="2"/><path class="core" d="M50 36 L62 58 L38 58 Z" fill="'+lit+'" stroke="#fff" stroke-width="1.2" stroke-linejoin="round"/><circle class="core" cx="50" cy="50" r="5" fill="#fff"/></svg>';
}

// === Event Ticker 跑马灯 ===
let tickerEvents = [];
const EVENTS_URLS = [
  LIVE_URL.replace(/dashboard\.json$/, 'events.json'),
  FALLBACK_URL.replace(/dashboard-fallback\.json$/, 'events.json'),
];
async function loadTicker(){
  try {
    let j = null;
    for(const url of EVENTS_URLS){
      try{
        const r = await fetch(url + '?t=' + Date.now(), {cache:'no-store'});
        if(r.ok){ j = await r.json(); break; }
      }catch(_){ /* try next source */ }
    }
    if(!j) return;
    const priority = {FALLBACK:0, ALERT:1, QC:2, DEPLOY:3};
    tickerEvents = (j.events || [])
      .sort((a,b)=>{
        const ta=String(a.tag||'').toUpperCase(), tb=String(b.tag||'').toUpperCase();
        const pa=priority[ta] ?? 9, pb=priority[tb] ?? 9;
        return pa===pb ? String(b.ts||'').localeCompare(String(a.ts||'')) : pa-pb;
      });
    if(tickerEvents.length===0) return;
    const stream = document.getElementById('tickerStream');
    if(!stream) return;
    const items = [];
    const tagClass = {QC:'qc',DEPLOY:'deploy',FALLBACK:'fallback',ALERT:'alert',CRON:'qc',DEPLOY_ROLLBACK:'fallback'};
    for(const e of tickerEvents){
      const tc = tagClass[e.tag] || 'qc';
      const time = (e.ts||'').replace(/^2026-0?6?-?0?/, '').replace(/T/, ' ').slice(0,11).trim();
      const tag = String(e.tag || '').toUpperCase();
      const msg = String(e.msg || '').toUpperCase();
      items.push(`<span class="event-item"><span class="ev-time">${time}</span><span class="ev-tag ${tc}">${tag}</span><span class="ev-msg">${msg}</span></span>`);
    }
    // 单行跑马灯：标题+内容一起滚，无缝循环 = 内容 × 2
    const html = items.join('') + items.join('');
    stream.innerHTML = html;
    // 计算滚动宽度（内容一半 = 一轮循环）
    const w = stream.scrollWidth / 2;
    stream.style.setProperty('--scroll-end', `-${w}px`);
    // 速度自适应：每轮约 45-110 秒，按字符数调整（介于初版与慢速版之间）
    const totalLen = tickerEvents.reduce((s,e)=>s+e.msg.length+15,0);
    const dur = Math.max(45, Math.min(110, totalLen * 0.18));
    stream.style.setProperty('--scroll-dur', dur+'s');
  }catch(_){ /* ticker 失败静默，不阻塞 dashboard */ }
}

function render(DATA){
  const agentCount = Object.values(DATA.agents || {}).length;
  document.getElementById('ts').textContent = '⟦ '+DATA.generated_at+' ⟧';
  document.getElementById('suitsMonitored').textContent = '◉ J.A.R.V.I.S. ONLINE · '+agentCount+' SUITS MONITORED';
  document.getElementById('gen').textContent = DATA.generated_at;
  const g=DATA.grand;
  const summary = [
    {k:'TODAY TOKENS',v:fmtTok(g.today_tok||0),u:'',c:'',sub:'累计 '+fmtTok(g.tok||0)+' tok'},
    {k:'TODAY COST',v:'$'+(g.today_cost||0).toFixed(2),u:'USD',c:'g',sub:'累计 $'+(g.cost||0).toFixed(2)+' · '+fmt(g.calls||0)+' calls'},
    {k:'CACHE SAVINGS',v:'$'+(g.today_save||0).toFixed(2),u:'USD',c:'a',sub:'累计 $'+Math.round(g.save||0)+' total'},
    {k:'ACTIVE SUITS',v:Object.values(DATA.agents).filter(a=>a.status==='ONLINE').length+'/'+Object.values(DATA.agents).length,u:'',c:'',sub:Object.values(DATA.agents).filter(a=>a.status==='IDLE').length+' idle · '+Object.values(DATA.agents).filter(a=>a.status==='OFFLINE').length+' offline'},
  ].map(s=>`<div class="stat ${s.c}"><div class="k">${s.k}</div><div class="v">${s.v} <span class="u">${s.u}</span></div><div class="sub">${s.sub}</div></div>`).join('');

  // 近 7 天趋势：柱状 + 曲线叠加 + per-agent breakdown tooltip
  const tr=DATA.trend||[];
  const N=tr.length||1;
  const maxTrendCost=Math.max(1,...tr.map(t=>t.cost||0));
  const trendBars=tr.map((t,i)=>{
    const h=((t.cost||0)/maxTrendCost*100).toFixed(0);
    const dd=t.date.slice(5);
    const isToday=t.date===DATA.today;
    // breakdown HTML
    const bd=Object.values(t.by_agent||{}).sort((a,b)=>b.tok-a.tok).map(a=>
      `<div class="bd-row"><span class="bd-n">${a.emoji} ${a.name}</span><span class="bd-t">${fmtTok(a.tok)}</span><span class="bd-c">$${a.cost.toFixed(2)}</span></div>`).join('')
      || '<div class="bd-row" style="color:var(--dim)">no activity</div>';
    return `<div class="tbar-wrap" data-i="${i}">
      <div class="tbar-val">$${Math.round(t.cost)}</div>
      <div class="tbar ${isToday?'today':''}" style="height:${Math.max(4,h)}%"></div>
      <div class="tbar-day">${dd}</div>
      <div class="bd-tip"><div class="bd-date">${t.date}${isToday?' · TODAY':''}</div>${bd}<div class="bd-tot">总计 ${fmtTok(t.tok)} · $${t.cost.toFixed(2)}</div></div>
    </div>`;
  }).join('');
  // SVG 曲线占位（用 pixel viewBox，render 后由 drawTrendCurve() 读真实柱顶坐标绘制，保证 100% 对齐）
  const svgCurve=`<svg class="trend-curve" preserveAspectRatio="none"><path class="tline"/><g class="tdots"></g></svg>`;
  const trendBlock=`<section class="trend-sec"><div class="trend-head">7-DAY POWER TREND · 近7天趋势 <span class="trend-sum">近7日 ${fmtTok(g.last7d_tok||0)} tok · $${(g.last7d_cost||0).toFixed(2)}</span></div><div class="trend-chart">${svgCurve}${trendBars}</div></section>`;

  const maxTok = Math.max(...Object.values(DATA.agents).map(a=>a.total_tok));
  const suits = Object.entries(DATA.agents).map(([aid,a],idx)=>{
    const st=a.status.toLowerCase();
    const idle = a.idle_min==null?'—':(a.idle_min<60?a.idle_min+'m ago':a.idle_min<1440?Math.round(a.idle_min/60)+'h ago':Math.round(a.idle_min/1440)+'d ago');
    const pct=(a.total_tok/maxTok*100).toFixed(0);
    const mdls=a.models.slice(0,3).map(m=>m.name.split('/')[1]+' <span>'+fmtTok(m.tok)+'</span>').join('  ·  ');
    const cardName=CARD_NAME_OVERRIDES[aid]||a.name;
    return `<div class="suit ${st}">
      <div class="suit-head">
        <div class="reactor ${st}" style="--ac:${a.ac||'#888'};--glow:${(a.lit||'#7fdfff')}55">${reactorSvg(a.ac||'#888', a.lit||'#7fdfff', aid||idx)}</div>
        <div class="suit-id"><div class="mark">${a.mark}</div><div class="nm">${cardName}</div><div class="role">${a.role}</div></div>
        <div class="badge ${st}">● ${a.status}</div>
      </div>
      <div class="suit-grid">
        <div class="cell"><div class="lbl">POWER</div><div class="val gold">${fmtTok(a.today_tok||0)} / ${fmtTok(a.total_tok||0)}</div></div>
        <div class="cell"><div class="lbl">FUEL BURN</div><div class="val">$${(a.today_cost||0).toFixed(2)} / $${(a.cost||0).toFixed(2)}</div></div>
        <div class="cell"><div class="lbl">REACTOR EFF.</div><div class="val arc">${a.today_cache_eff||0}% / ${a.cache_eff||0}%</div></div>
        <div class="cell"><div class="lbl">Last Active</div><div class="val" style="font-size:13px">${idle}</div></div>
        <div class="pwr"><div class="lbl" style="font-size:9px;color:var(--dim)">POWER LEVEL</div><div class="bar"><div class="fill" style="width:${pct}%"></div></div></div>
        <div class="models-mini">⚡ ${mdls}</div>
      </div>
    </div>`;
  }).join('');

  const models = DATA.models.map(m=>
    `<tr><td class="mdl">${m.name}</td><td class="r">${fmt(m.calls)}</td><td class="r">${fmtTok(m.tok)}</td><td class="r" style="color:var(--gold)">$${m.cost.toFixed(2)}</td></tr>`
  ).join('');

  const chain = Object.entries(DATA.agents).map(([id,a])=>{
    const ch=CHAINS[id]||[];
    const active=a.active_model;
    const activeIdx=ch.findIndex(n=>chainModelKey(n)===active);
    const yellowIdx=activeIdx>=0?activeIdx:0;
    const nodes=ch.map((n,i)=>`<span class="node ${i===yellowIdx?'primary':'fb'}">${n}</span>`).join('<span class="arr">▸</span>');
    return `<div class="agent-row"><span class="who">${a.mark} · ${a.name}</span>${nodes}</div>`;
  }).join('');

  // ===== CAPABILITY MATRIX =====
  const cap = DATA.capabilities || null;
  let capMatrix = '';
  if(cap && cap.domains && cap.domains.length){
    window._CAP_DOMAINS = cap.domains;
    const maxTotal = Math.max(1, ...cap.domains.map(d=>d.total));
    const rows = cap.domains.map((d,i)=>{
      const filled = Math.max(1, Math.round(d.total/maxTotal*10));
      const bar = Array.from({length:10},(_,k)=>`<i class="${k<filled?'on':'off'}"></i>`).join('');
      return `<button class="cap-row" onclick="capOpen(${i})">`+
        `<span class="cr-name">${_esc(d.domain)}</span>`+
        `<span class="cr-bar">${bar}</span>`+
        `<span class="cr-num">${d.total}</span>`+
        `<span class="cr-ws">${d.ws}<small>WS</small></span>`+
        `<span class="cr-st"></span>`+
        `<span class="cr-arrow">\u25B8</span></button>`;
    }).join('');
    capMatrix = `<div class="capcard">`+
      `<div class="cap-head"><h2 class="sec cap-sec">CAPABILITY MATRIX · 能力矩阵</h2>`+
        `<span class="cap-stat"><span class="ca"><b>${cap.total}</b>TOTAL</span><span><b style="color:#e6edf6">${cap.ndomains}</b>DOMAINS</span><span class="ca"><b>${cap.ws_scoped}</b>WS</span><span class="cg"><b>${cap.shared}</b>SHARED</span></span>`+
      `</div>`+
      `<div class="cap-list">${rows}</div>`+
      `<div class="cap-legend"><span class="ld"></span><b>BAR</b> RELATIVE SCALE &nbsp;\u00b7&nbsp; <b style="color:var(--gold)">GOLD#</b> TOTAL SKILLS &nbsp;\u00b7&nbsp; <b>BLUE WS</b> WORKSPACE-SCOPED &nbsp;\u00b7&nbsp; <span class="ldot"></span><b>GREEN</b> ONLINE &nbsp;\u00b7&nbsp; CLICK A ROW TO EXPAND \u00b7 WORKSPACE-SCOPED FIRST, SHARED COLLAPSED \u00b7 AUTO-REFRESHED ON INSTALL/REMOVE</div>`+
    `</div>`;
  }

  // ===== AGENT TOPOLOGY · 调度架构 =====
  const _agName = aid => (CARD_NAME_OVERRIDES[aid] || (DATA.agents[aid] && DATA.agents[aid].name) || aid);
  // 窄屏紧凑徽章：短代号 + 短职能 + 中文名（桌面不用，仅 ≤768px 显示）
  const ARCH_CODE = { main:'M1', aima:'PA', mk2:'MK2', mk46:'MK46', 'claude-researcher':'MK51' };
  const ARCH_SHORTROLE = { main:'ORCHESTRATOR', aima:'ASSISTANT', mk2:'ENGINEER', mk46:'QC', 'claude-researcher':'SENTINEL' };
  const ARCH_SHORTNM = { main:'统帅', aima:'银月', mk2:'工程师', mk46:'校官', 'claude-researcher':'哨兵' };
  function _archNode(aid, cls){
    const a = DATA.agents[aid]; if(!a) return '';
    const st = (a.status||'').toLowerCase();
    const on = st!=='offline' && st!=='off';
    const role = String(a.role||'').toUpperCase();
    const roleHtml = _esc(role).replace(/ /,'<br>'); // 先转义再插 <br>（首个空格处断行）
    const _rawColor = a.lit || a.ac || '#9fe8ff';
    const markColor = /^#[0-9a-fA-F]{3,8}$/.test(_rawColor) ? _rawColor : '#9fe8ff'; // 仅放行 hex 色值
    const direct = cls==='worker' ? '<span class="arch-direct">DIRECT</span>' : '';
    const code = _esc(ARCH_CODE[aid] || a.mark || aid);
    const srole = _esc(ARCH_SHORTROLE[aid] || role.split(' ')[0]);
    const snm = _esc(ARCH_SHORTNM[aid] || _agName(aid));
    // 桌面形态 (.arch-full) 与 窄屏形态 (.arch-mini) 同时输出，CSS 控显隐
    return `<div class="arch-node ${cls}" id="arch-${aid}">${direct}`+
      `<div class="arch-full">`+
        `<div class="arch-mark" style="color:${markColor}">${_esc(a.mark||'')}</div>`+
        `<div class="arch-nm">${_esc(_agName(aid))}</div>`+
        `<div class="arch-role"><span class="arch-rlabel">${roleHtml}</span>`+
          `<span class="arch-st"><span class="arch-stdot ${on?'on':'off'}"></span>${_esc(a.status||'')}</span></div>`+
      `</div>`+
      `<div class="arch-mini">`+
        `<span class="mb-st ${on?'on':'off'}"></span>`+
        `<div class="mb-code" style="color:${markColor}">${code}</div>`+
        `<div class="mb-role">${srole}</div>`+
        `<div class="mb-nm">${snm}</div>`+
      `</div>`+
    `</div>`;
  }
  const _t1 = ['main','aima'].filter(id=>DATA.agents[id]);
  const _t2 = ['mk2','mk46','claude-researcher'].filter(id=>DATA.agents[id]);
  const archTopology = (_t1.length && _t2.length) ? `
    <div class="arch-card">
      <div class="arch-head">
        <span class="arch-title">AGENT TOPOLOGY · 调度架构</span>
        <span class="arch-legend">
          <span class="alg"><span class="aln solid"></span> MAIN 调度链</span>
          <span class="alg"><span class="aln dot"></span> 银月 调度链</span>
          <span class="alg"><span class="adot"></span> 独立可访问</span>
        </span>
      </div>
      <div class="arch-topo" id="archTopo">
        <svg class="arch-lines" id="archLines"></svg>
        <div class="arch-tier t1">${_t1.map(id=>_archNode(id,'orch')).join('')}</div>
        <div class="arch-tier t2">${_t2.map(id=>_archNode(id,'worker')).join('')}</div>
      </div>
    </div>` : '';

  document.getElementById('app').innerHTML = `
    <section class="summary">${summary}</section>
    ${trendBlock}
    ${archTopology}
    <h2 class="sec">SUIT STATUS · 战甲编队</h2>
    <section class="suits">${suits}</section>
    <div class="toprow">
      ${capMatrix}
      <div class="panel">
        <h2 class="sec">FALLBACK SYSTEMS · 模型备用链路</h2>
        <div class="chain">${chain}</div>
      </div>
    </div>
    <div class="toprow">
      <div class="panel">
        <h2 class="sec">POWER CONSUMPTION · 能量消耗</h2>
        <table><thead><tr><th>MODEL</th><th>CALLS</th><th>TOKENS</th><th>COST</th></tr></thead><tbody>${models}</tbody></table>
      </div>
    </div>
    <div class="cap-ov" id="capOv" onclick="capClose()"></div>
    <div class="cap-pop" id="capPop"></div>`;

  // 渲染后用真实柱顶坐标绘制趋势曲线（100% 对齐，不受 gap/padding 影响）
  requestAnimationFrame(()=>drawTrendCurve(DATA));
  requestAnimationFrame(()=>drawArchLines());
}

// ===== AGENT TOPOLOGY 蓝色辉光调度连线 =====
function drawArchLines(){
  const svg=document.getElementById('archLines');
  const topo=document.getElementById('archTopo');
  if(!svg||!topo) return;
  const R=topo.getBoundingClientRect();
  if(!R.width) return;
  svg.setAttribute('viewBox',`0 0 ${R.width} ${R.height}`);
  const c=id=>{const el=document.getElementById('arch-'+id); if(!el) return null; const r=el.getBoundingClientRect();
    return {cx:r.left-R.left+r.width/2, top:r.top-R.top, bot:r.top-R.top+r.height};};
  const main=c('main'), aima=c('aima');
  const workers=['mk2','mk46','claude-researcher'].map(c).filter(Boolean);
  const pathD=(x1,y1,x2,y2)=>{const my=(y1+y2)/2;return `M${x1},${y1} C${x1},${my} ${x2},${my} ${x2},${y2}`;};
  // 自适应：窄屏(≤768px)用更细的连线 + 更小的偏移/端点
  const M = window.matchMedia && window.matchMedia('(max-width:768px)').matches;
  // mOff/aOff = 源端(编排者底部)偏移；mDst/aDst = 宜端(worker 顶部)偏移。桌面保持原始：src14/dst16
  const P = M
    ? {mOff:6, mDst:8, mHalo:4, mCore:1.3, mFlowW:1.3, mFlowDash:'1.6 18', mFlowTo:-19.6, mEnd:2.4, mEndIn:1.1, mStart:2.5, mStartIn:1.2,
       aOff:6, aDst:8, aHalo:3, aCore:2.2, aDash:'0.1 6', aTo:-12.2, aEnd:2, aEndIn:0.9, aStart:2.1, aStartIn:1, blur:2.5, glow:1.2}
    : {mOff:14, mDst:16, mHalo:7, mCore:2, mFlowW:2, mFlowDash:'2 22', mFlowTo:-24, mEnd:3.4, mEndIn:1.6, mStart:3.6, mStartIn:1.7,
       aOff:14, aDst:16, aHalo:5, aCore:3, aDash:'0.1 8', aTo:-16, aEnd:2.8, aEndIn:1.3, aStart:3, aStartIn:1.4, blur:3.5, glow:1.6};
  let halo='',core='',flow='',ends='',starts='';
  if(main){
    workers.forEach((w,i)=>{
      const d=pathD(main.cx-P.mOff,main.bot,w.cx-P.mDst,w.top);
      halo+=`<path d="${d}" fill="none" stroke="#00E5FF" stroke-width="${P.mHalo}" opacity="0.22" filter="url(#aBlur)"/>`;
      core+=`<path d="${d}" fill="none" stroke="url(#aGradMain)" stroke-width="${P.mCore}" opacity="0.95" filter="url(#aGlow)"/>`;
      flow+=`<path d="${d}" fill="none" stroke="#dffbff" stroke-width="${P.mFlowW}" stroke-linecap="round" stroke-dasharray="${P.mFlowDash}" opacity="0.9"><animate attributeName="stroke-dashoffset" from="0" to="${P.mFlowTo}" dur="${0.9+i*0.12}s" repeatCount="indefinite"/></path>`;
      ends+=`<circle cx="${w.cx-P.mDst}" cy="${w.top}" r="${P.mEnd}" fill="#00E5FF" filter="url(#aGlow)"/><circle cx="${w.cx-P.mDst}" cy="${w.top}" r="${P.mEndIn}" fill="#eafdff"/>`;
    });
    starts+=`<circle cx="${main.cx-P.mOff}" cy="${main.bot}" r="${P.mStart}" fill="#00E5FF" filter="url(#aGlow)"/><circle cx="${main.cx-P.mOff}" cy="${main.bot}" r="${P.mStartIn}" fill="#eafdff"/>`;
  }
  if(aima){
    workers.forEach((w,i)=>{
      const d=pathD(aima.cx+P.aOff,aima.bot,w.cx+P.aDst,w.top);
      halo+=`<path d="${d}" fill="none" stroke="#2f8fd0" stroke-width="${P.aHalo}" opacity="0.16" filter="url(#aBlur)"/>`;
      core+=`<path d="${d}" fill="none" stroke="url(#aGradAima)" stroke-width="${P.aCore}" stroke-linecap="round" stroke-dasharray="${P.aDash}" opacity="0.95" filter="url(#aGlow)"><animate attributeName="stroke-dashoffset" from="0" to="${P.aTo}" dur="${1.8+i*0.2}s" repeatCount="indefinite"/></path>`;
      ends+=`<circle cx="${w.cx+P.aDst}" cy="${w.top}" r="${P.aEnd}" fill="#48b4ec" filter="url(#aGlow)"/><circle cx="${w.cx+P.aDst}" cy="${w.top}" r="${P.aEndIn}" fill="#cdeeff"/>`;
    });
    starts+=`<circle cx="${aima.cx+P.aOff}" cy="${aima.bot}" r="${P.aStart}" fill="#48b4ec" filter="url(#aGlow)"/><circle cx="${aima.cx+P.aOff}" cy="${aima.bot}" r="${P.aStartIn}" fill="#cdeeff"/>`;
  }
  const defs=`<defs>`+
    `<filter id="aBlur" x="-60%" y="-60%" width="220%" height="220%"><feGaussianBlur stdDeviation="${P.blur}"/></filter>`+
    `<filter id="aGlow" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="${P.glow}" result="b"/><feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge></filter>`+
    `<linearGradient id="aGradMain" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#7fefff"/><stop offset="1" stop-color="#1fb6ff"/></linearGradient>`+
    `<linearGradient id="aGradAima" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#6fd0ff"/><stop offset="1" stop-color="#2f8fd0"/></linearGradient>`+
  `</defs>`;
  svg.innerHTML=defs+halo+core+flow+starts+ends;
}

// ===== CAPABILITY MATRIX 展开面板 =====
function _esc(s){return String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');}
function _capSkillRow(s){
  const ico = s.emoji || '\u25A3';
  const src = s.shared ? '<span class="csk-shared">SHARED</span>'
    : (s.agents||[]).map(a=>`<span class="csk-atag">${_esc(a)}</span>`).join('');
  return `<div class="csk"><div class="csk-ico">${ico}</div>`+
    `<div class="csk-body"><div class="csk-name">${_esc(s.name)}</div><div class="csk-desc">${_esc(s.desc)}</div></div>`+
    `<div class="csk-src">${src}</div></div>`;
}
function capOpen(i){
  const doms = window._CAP_DOMAINS || [];
  const d = doms[i]; if(!d) return;
  const ws = (d.ws_skills||[]).map(_capSkillRow).join('') || '<div class="csk-empty">\u2014 NONE \u2014</div>';
  const shared = (d.shared_skills||[]);
  const sharedBlock = shared.length
    ? `<div class="cap-fold"><button class="cap-foldbtn" onclick="this.parentNode.classList.toggle('open')">+ ${shared.length} SHARED BUNDLED \u25BE</button><div class="cap-foldbody">${shared.map(_capSkillRow).join('')}</div></div>`
    : '';
  const pop = document.getElementById('capPop');
  pop.innerHTML = `<div class="cp-head"><span>${_esc(d.domain)}</span><button class="cp-x" onclick="capClose()">\u2715 CLOSE</button></div>`+
    `<div class="cp-sec">WORKSPACE-SCOPED (${d.ws})</div><div class="cp-grid">${ws}</div>${sharedBlock}`;
  document.getElementById('capOv').classList.add('on');
  pop.classList.add('on');
}
function capClose(){
  const ov=document.getElementById('capOv'); const pop=document.getElementById('capPop');
  if(ov) ov.classList.remove('on');
  if(pop) pop.classList.remove('on');
}
// Astro <script define:vars> 是模块作用域，inline onclick="capOpen(..)" 找不到模块内函数 → 必须挂到 window
window.capOpen = capOpen;
window.capClose = capClose;
document.addEventListener('keydown',e=>{if(e.key==='Escape')capClose();});

function drawTrendCurve(DATA){
  const chart=document.querySelector('.trend-chart');
  const svg=document.querySelector('.trend-curve');
  if(!chart||!svg) return;
  const tr=DATA.trend||[];
  const cb=chart.getBoundingClientRect();
  // SVG 覆盖整个 chart，viewBox = chart 像素尺寸，坐标直接用 px
  svg.setAttribute('viewBox',`0 0 ${cb.width} ${cb.height}`);
  svg.style.left='0';svg.style.top='0';svg.style.width='100%';svg.style.height='100%';
  const bars=[...chart.querySelectorAll('.tbar')];
  const pts=bars.map(el=>{
    const r=el.getBoundingClientRect();
    return {x:r.left+r.width/2-cb.left, y:r.top-cb.top};
  });
  // 平滑曲线：Catmull-Rom 转贝塞尔，自然弧度过渡每个节点
  const poly=svg.querySelector('.tline');
  let dPath='';
  if(pts.length>0){
    dPath='M '+pts[0].x.toFixed(1)+' '+pts[0].y.toFixed(1);
    for(let i=0;i<pts.length-1;i++){
      const p0=pts[i-1]||pts[i], p1=pts[i], p2=pts[i+1], p3=pts[i+2]||p2;
      const t=0.16; // 张力，越小越缓
      const c1x=p1.x+(p2.x-p0.x)*t, c1y=p1.y+(p2.y-p0.y)*t;
      const c2x=p2.x-(p3.x-p1.x)*t, c2y=p2.y-(p3.y-p1.y)*t;
      dPath+=' C '+c1x.toFixed(1)+' '+c1y.toFixed(1)+', '+c2x.toFixed(1)+' '+c2y.toFixed(1)+', '+p2.x.toFixed(1)+' '+p2.y.toFixed(1);
    }
  }
  poly.setAttribute('d',dPath);
  const g=svg.querySelector('.tdots');
  g.innerHTML=pts.map((p,i)=>{
    const isToday=(tr[i]&&tr[i].date===DATA.today);
    return `<circle cx="${p.x.toFixed(1)}" cy="${p.y.toFixed(1)}" r="4" class="tdot ${isToday?'today':''}"/>`;
  }).join('');
}
let _trendData=null;
window.addEventListener('resize',()=>{ if(_trendData) drawTrendCurve(_trendData); drawArchLines(); });

let _firstLoad=true;
async function tick(){
  try{
    // 优先实时端点；失败则回退静态快照
    let d;
    try{
      d = await (await fetch(LIVE_URL, {cache:'no-store'})).json();
    }catch(err){
      console.warn('[SHRIMP] LIVE telemetry unreachable, falling back to static snapshot:', err);
      d = await (await fetch(FALLBACK_URL + '?t=' + Date.now(), {cache:'no-store'})).json();
    }
    _trendData=d; render(d); loadTicker(); _firstLoad=false;
  }catch(e){
    if(_firstLoad){
      document.getElementById('app').innerHTML='<div class="loading" style="color:var(--red)">⚠ TELEMETRY LINK FAILED · '+e.message+'</div>';
    }
    // 非首次失败：保留上一帧画面，不闪烁
  }
}
// ===== 访问门：8 位数字锁（纯前端，仅防普通人随手查看）=====
// 未解锁不 fetch 任何数据。解锁后存 localStorage，下次免输。
const _PIN = '11428089';
const _PIN_KEY = 'shrimp_pin_ok';
let _started = false;
function _startDash(){
  if(_started) return; _started = true;
  document.body.classList.remove('gate-locked');
  tick();
  setInterval(tick, 60000);  // 每 60 秒刷新
}
function _gate(){
  if(localStorage.getItem(_PIN_KEY) === _PIN){ _startDash(); return; }
  document.body.classList.add('gate-locked');
  const app = document.getElementById('app');
  app.innerHTML = `<main class="login-gate" lang="en">
    <div class="login-top"><div class="login-brand">S.H.R.I.M.P. OS</div><div class="login-private-badge">PRIVATE NODE</div></div>
    <div class="login-reactor" aria-hidden="true">
      <svg viewBox="0 0 100 100">
        <defs><radialGradient id="loginGateGlow"><stop offset="0%" stop-color="#fff"/><stop offset="28%" stop-color="#7fdfff"/><stop offset="70%" stop-color="#3fc9ff" stop-opacity=".35"/><stop offset="100%" stop-color="#3fc9ff" stop-opacity="0"/></radialGradient></defs>
        <g class="login-rotor"><circle cx="50" cy="50" r="46" fill="none" stroke="#16384b" stroke-width="2"/><circle cx="50" cy="50" r="39" fill="none" stroke="#ffc400" stroke-width="2.4" stroke-dasharray="4 5"/><circle cx="50" cy="50" r="28" fill="none" stroke="#3fc9ff" stroke-width="3" opacity=".8"/></g>
        <circle cx="50" cy="50" r="18" fill="url(#loginGateGlow)" opacity=".95"/>
        <path class="login-tri" d="M50 64 L65 38 L35 38 Z" fill="#7fdfff" stroke="#fff" stroke-width="1.2"/>
      </svg>
    </div>
    <h1 class="login-title">ACCESS GATE</h1>
    <p class="login-subtitle">Telemetry console locked<br/>Authenticate to boot reactor interface</p>
    <div class="login-terminal"><b>root@shrimp-os</b>: initiating private dashboard handshake<br/><b>auth</b>: enter 8-digit operator code <span class="login-cursor"></span></div>
    <form id="pinForm" class="login-form">
      <label class="login-pin-wrap"><span class="login-prompt">PIN&gt;</span><input id="pinInput" class="login-input" type="password" inputmode="numeric" maxlength="8" placeholder="••••••••" autocomplete="off" /></label>
      <button class="login-btn" type="submit">UNLOCK CONSOLE</button>
      <div id="pinErr" class="login-err"></div>
    </form>
    <div class="login-meta"><span>NOINDEX</span><span>LOCAL SESSION</span><span>v0.5</span></div>
  </main>`;
  const inp = document.getElementById('pinInput');
  inp.focus();
  document.getElementById('pinForm').addEventListener('submit', (e)=>{
    e.preventDefault();
    if(inp.value === _PIN){
      localStorage.setItem(_PIN_KEY, _PIN);
      app.innerHTML = '<div class="loading"><span class="pulse">◉ BOOTING REACTOR · LOADING TELEMETRY...</span></div>';
      _startDash();
    }else{
      document.getElementById('pinErr').textContent = 'ACCESS DENIED · INVALID OPERATOR CODE';
      inp.value=''; inp.focus();
    }
  });
}
_gate();
</script>
