---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SectionSprite from '../components/SectionSprite.astro';
import { loadAll, dayOfWeekZh, getYearMonth } from '../lib/data';
import '../styles/sections.css';

const reports = loadAll();
const base = import.meta.env.BASE_URL;

// 按月分组（按时间倒序）
const grouped = new Map<string, typeof reports>();
for (const r of reports) {
  const ym = getYearMonth(r.date);
  if (!grouped.has(ym)) grouped.set(ym, []);
  grouped.get(ym)!.push(r);
}
const months = Array.from(grouped.entries()); // 已是倒序，因为 reports 倒序

function monthLabel(ym: string) {
  const [y, m] = ym.split('-').map(Number);
  return `${y} 年 ${m} 月`;
}
function monthEyebrow(ym: string) {
  const [y, m] = ym.split('-');
  return `${y} · ${m}`;
}

// 动态 stat
const totalReports = reports.length;
const monthCount = months.length;
function splitStat(n: number): { head: string; tail: string } {
  const s = String(n);
  if (s.length <= 1) return { head: '', tail: s };
  return { head: s.slice(0, -1), tail: s.slice(-1) };
}
const totalStat = splitStat(totalReports);
---
<Base title="档案库" description="所有往期 AI 日报档案，按月分类可回溯。">
  <Header />
  <SectionSprite />
  <main class="sec-page" style="--acc:#06B6D4;--acc-deep:#0E7490;--acc-ghost:#E5F8FC;--acc-band:#F3FCFE">
    <section class="hero"><div class="wrap">
      <span class="badge"><svg class="ic"><use href="#i-cal"/></svg>Vault</span>
      <h1>档案<span class="pu">库</span></h1>
      <p class="hero-sub">全部往期日报按月归类，每期附当日核心观点，点击回看完整内容。</p>
      <div class="stats">
        <div class="stat"><b>{totalStat.head}<i>{totalStat.tail}</i></b><span>累计期数</span></div>
        <div class="stat"><b>{monthCount}</b><span>覆盖月份</span></div>
      </div>
    </div></section>

    <div class="wrap">
      {months.length === 0 ? (
        <div class="empty"><p>暂无档案。</p></div>
      ) : (
        months.map(([ym, list], idx) => (
          <details class="month-block" open={idx === 0}>
            <summary class="sec-head">
              <span class="sq"><svg class="ic"><use href="#i-cal"/></svg></span>
              <div class="tt"><span class="eyebrow">{monthEyebrow(ym)}</span><h2>{monthLabel(ym)}</h2></div>
              <span class="rule"></span><span class="cnt">{list.length} 期</span>
              <svg class="chev" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
            </summary>
            <div class="arch-grid">
              {list.map((r) => {
                const totalItems = r.sections.reduce((sum, s) => sum + s.items.length, 0);
                const [, mm, dd] = r.date.split('-');
                return (
                  <a class="arch-card" href={`${base}d/${r.date}/`}>
                    <div class="arch-date">
                      <b>{Number(mm)}.{dd}</b>
                      <span>{dayOfWeekZh(r.date)}</span>
                      <span class="n">{totalItems} 条</span>
                    </div>
                    {r.closing?.[0] && <p>{r.closing[0]}</p>}
                  </a>
                );
              })}
            </div>
          </details>
        ))
      )}
    </div>
  </main>
  <Footer />
</Base>

<style>
  summary.sec-head { cursor: pointer; user-select: none; list-style: none; }
  summary.sec-head::-webkit-details-marker { display: none; }
  summary.sec-head .chev { flex: none; margin-bottom: 9px; color: var(--gray-4, #9d9daa); transition: transform 0.18s; }
  summary.sec-head:hover .chev { color: var(--acc-deep, #0E7490); }
  details[open] > summary.sec-head .chev { transform: rotate(180deg); }
  details.month-block:not([open]) > summary.sec-head { margin-bottom: 6px; }
</style>
