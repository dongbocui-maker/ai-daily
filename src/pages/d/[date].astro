---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import AudioPlayer from '../../components/AudioPlayer.astro';
import { listDates, loadDate, formatDateZh, dayOfWeekZh, formatDateShort, type NewsItem, type SectionKey } from '../../lib/data';
import '../../styles/sections.css';

export async function getStaticPaths() {
  return listDates().map((date) => ({
    params: { date },
    props: { report: loadDate(date) },
  }));
}

const { report } = Astro.props;
if (!report) throw new Error('Report not found');

const base = import.meta.env.BASE_URL;

// 板块元信息：英文眉题 + 中文标题 + 线性 SVG icon（与首页一致）
const sectionMeta: Record<SectionKey, { label: string; icon: string; eyebrow: string }> = {
  news: { label: 'AI 热点新闻', icon: 'zap', eyebrow: 'Headlines' },
  enterprise: { label: '企业级 AI 实践', icon: 'building', eyebrow: 'Enterprise' },
  coding: { label: 'AI Coding 动态', icon: 'code', eyebrow: 'Coding' },
  report: { label: '深度报告与论文', icon: 'chart', eyebrow: 'Research' },
};

// 把「标题」拆成 tag pill + 正文标题（去掉行首 emoji，切分「tag | 标题」）
function itemParts(item: NewsItem) {
  const raw = item.title ?? '';
  const withoutEmoji = raw.replace(/^\p{Extended_Pictographic}[\uFE0F\u200D\p{Extended_Pictographic}]*\s*/u, '');
  const split = withoutEmoji.match(/^([^|]{1,16})\s*\|\s*(.+)$/s);
  return split ? { tag: split[1].trim(), title: split[2].trim() } : { tag: '行业动态', title: withoutEmoji.trim() };
}

function tagIcon(tag: string) {
  if (/战略|合作/.test(tag)) return 'handshake';
  if (/融资|资本/.test(tag)) return 'coins';
  if (/市场|数据/.test(tag)) return 'chart';
  if (/产品|发布/.test(tag)) return 'rocket';
  if (/工具|生态/.test(tag)) return 'tool';
  if (/研究|报告|论文|政策/.test(tag)) return 'doc';
  if (/技术|模型/.test(tag)) return 'zap';
  return 'building';
}

const totalItems = report.sections.reduce((sum, s) => sum + s.items.length, 0);
const sectionCount = report.sections.length;
const heroBrief = report.closing?.find(Boolean);

// 日期标题：如「7 月 26 日 日报」，末词重音
const [, mm, dd] = report.date.split('-').map(Number) as unknown as [number, number, number];

// 前后期导航
const dates = listDates();
const idx = dates.indexOf(report.date);
const prev = idx >= 0 && idx < dates.length - 1 ? dates[idx + 1] : null;
const next = idx > 0 ? dates[idx - 1] : null;
---
<Base title={`AI 日报 ${report.date}`} description={report.summary}>
  <Header currentDate={report.date} />

  <svg width="0" height="0" style="position:absolute" aria-hidden="true">
    <symbol id="i-feed" viewBox="0 0 24 24"><path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1"/></symbol>
    <symbol id="i-zap" viewBox="0 0 24 24"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></symbol>
    <symbol id="i-building" viewBox="0 0 24 24"><rect x="4" y="2" width="16" height="20" rx="1"/><path d="M9 22v-4h6v4M8 6h.01M16 6h.01M12 6h.01M8 10h.01M16 10h.01M12 10h.01M8 14h.01M16 14h.01M12 14h.01"/></symbol>
    <symbol id="i-code" viewBox="0 0 24 24"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></symbol>
    <symbol id="i-chart" viewBox="0 0 24 24"><line x1="12" y1="20" x2="12" y2="10"/><line x1="18" y1="20" x2="18" y2="4"/><line x1="6" y1="20" x2="6" y2="16"/></symbol>
    <symbol id="i-handshake" viewBox="0 0 24 24"><path d="M11 17l-1.5-1.5M14 14l-2 2M8 20l-3-3 7-7 3 3M13 5l7 7-3 3M2 12l5-5 3 3"/></symbol>
    <symbol id="i-coins" viewBox="0 0 24 24"><circle cx="8" cy="8" r="6"/><path d="M18.09 10.37A6 6 0 1 1 10.34 18M7 6h1v4"/></symbol>
    <symbol id="i-rocket" viewBox="0 0 24 24"><path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09zM12 15l-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/></symbol>
    <symbol id="i-tool" viewBox="0 0 24 24"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></symbol>
    <symbol id="i-doc" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></symbol>
    <symbol id="i-ext" viewBox="0 0 24 24"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></symbol>
    <symbol id="i-arrow-l" viewBox="0 0 24 24"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="11 6 5 12 11 18"/></symbol>
    <symbol id="i-arrow-r" viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="13 6 19 12 13 18"/></symbol>
  </svg>

  <main class="sec-page" style="--acc:#A100FF;--acc-deep:#7500C0;--acc-ghost:#F7EDFF;--acc-band:#FBF8FF">
    <section class="hero"><div class="wrap">
      <span class="badge"><svg class="ic"><use href="#i-feed"/></svg>Feed</span>
      <h1>{mm} 月 {dd} 日<span class="pu">日报</span></h1>
      {heroBrief && <p class="hero-sub">{heroBrief}</p>}
      <div class="stats">
        <div class="stat"><b>{formatDateZh(report.date).replace(/ /g, '')}</b><span>{dayOfWeekZh(report.date)}</span></div>
        <div class="stat"><b>{totalItems}<i>条</i></b><span>今日条数</span></div>
        <div class="stat"><b>{sectionCount}<i>板块</i></b><span>覆盖板块</span></div>
      </div>
      {report.audio && <AudioPlayer audio={report.audio} date={report.date} />}
    </div></section>

    {/* 前后期切换 */}
    <div class="wrap">
      <nav class="datenav">
        {prev ? (
          <a class="dn-btn" href={`${base}d/${prev}/`}>
            <svg class="ic"><use href="#i-arrow-l"/></svg>
            <span class="dn-tt"><em>前一日</em><b>{formatDateShort(prev)} · {dayOfWeekZh(prev)}</b></span>
          </a>
        ) : <span class="dn-btn dn-dis"></span>}
        <span class="dn-cur">{report.date}</span>
        {next ? (
          <a class="dn-btn dn-r" href={`${base}d/${next}/`}>
            <span class="dn-tt"><em>下一日</em><b>{formatDateShort(next)} · {dayOfWeekZh(next)}</b></span>
            <svg class="ic"><use href="#i-arrow-r"/></svg>
          </a>
        ) : <span class="dn-btn dn-dis"></span>}
      </nav>
    </div>

    <div class="wrap">
      {report.sections.map((section) => {
        const meta = sectionMeta[section.key];
        return (
          <section id={section.key}>
            <div class="sec-head">
              <span class="sq"><svg class="ic"><use href={`#i-${meta.icon}`}/></svg></span>
              <div class="tt"><span class="eyebrow">{meta.eyebrow}</span><h2>{meta.label}</h2></div>
              <span class="rule"></span><span class="cnt">{section.items.length} 条</span>
            </div>
            <div class="cards">
              {section.items.map((item) => {
                const parts = itemParts(item);
                return (
                  <article class="card">
                    <div class="meta">
                      <span class="pill"><svg class="ic"><use href={`#i-${tagIcon(parts.tag)}`}/></svg>{parts.tag}</span>
                      <span class="src">{item.source || '来源待补充'}</span>
                    </div>
                    <h3>{item.url ? <a href={item.url} target="_blank" rel="noopener noreferrer">{parts.title}</a> : parts.title}</h3>
                    <p>{item.body}</p>
                    {item.insight && <div class="d-insight"><b>洞察</b><span>{item.insight}</span></div>}
                    <div class="acts">
                      <a href={item.url || `${base}about/`} target="_blank" rel="noopener noreferrer">阅读原文<svg class="ic"><use href="#i-ext"/></svg></a>
                    </div>
                  </article>
                );
              })}
            </div>
          </section>
        );
      })}

      {report.closing && report.closing.filter(Boolean).length > 0 && (
        <section class="closing-panel">
          <h3>收盘点评</h3>
          {report.closing.filter(Boolean).map((p) => <p>{p}</p>)}
        </section>
      )}
    </div>
  </main>
  <Footer />
</Base>

<style>
  /* 前后期导航 */
  .sec-page .datenav { display: flex; align-items: center; justify-content: space-between; gap: 14px; margin: 22px 0 6px; padding: 12px 0; border-top: 1px solid var(--gray-2); border-bottom: 1px solid var(--gray-2); }
  .sec-page .dn-btn { display: inline-flex; align-items: center; gap: 10px; color: var(--gray-7); transition: .15s; }
  .sec-page .dn-btn .ic { font-size: 18px; color: var(--acc); }
  .sec-page .dn-btn:hover { color: var(--acc-deep); }
  .sec-page .dn-btn.dn-r { text-align: right; }
  .sec-page .dn-dis { visibility: hidden; }
  .sec-page .dn-tt { display: flex; flex-direction: column; gap: 1px; }
  .sec-page .dn-tt em { font-style: normal; font-size: 10px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; color: var(--gray-4); }
  .sec-page .dn-tt b { font-size: 14px; font-weight: 750; }
  .sec-page .dn-cur { font-size: 12px; font-weight: 600; color: var(--gray-4); font-family: ui-monospace, SFMono-Regular, Menlo, monospace; flex: none; }

  /* 卡片内洞察条 */
  .sec-page .d-insight { margin-top: 11px; padding: 9px 13px; background: var(--gray-1); border-left: 3px solid var(--acc); font-size: 14.5px; color: var(--gray-7); line-height: 1.6; }
  .sec-page .d-insight b { color: var(--acc-deep); font-weight: 800; letter-spacing: .03em; margin-right: 8px; }

  /* 卡片正文不截断（详情页要看全文） */
  .sec-page .card p { -webkit-line-clamp: unset; display: block; }

  /* 收盘点评面板 */
  .sec-page .closing-panel { margin: 40px 0 12px; background: #fff; border: 1px solid var(--gray-2); border-top: 3px solid var(--ink); border-radius: 6px; padding: 22px 22px; }
  .sec-page .closing-panel h3 { margin: 0 0 12px; font-size: 12px; font-weight: 850; letter-spacing: .1em; text-transform: uppercase; color: var(--gray-5); }
  .sec-page .closing-panel p { font-size: 15.5px; color: var(--gray-7); line-height: 1.75; margin: 0 0 10px; }
  .sec-page .closing-panel p:last-child { margin-bottom: 0; }

  @media (max-width: 480px) {
    .sec-page .dn-cur { display: none; }
    .sec-page .dn-tt b { font-size: 13px; }
  }
</style>
