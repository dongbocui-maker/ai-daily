<script define:vars={{ LIVE_URL, FALLBACK_URL, AGENT_CHAINS, AGENT_ARCH_EP, AGENT_CHAIN_KEYS }}>
// CHAINS: 优先用 build 时从 openclaw.json 生成的 AGENT_CHAINS（single source of truth）；
// 若 JSON 缺失/损坏则回退到硬编码 literal（仅兜底，可能过时）。
const CHAINS = AGENT_CHAINS || {
  main:['fable-5','opus-4.8','gpt-5.6-sol','qwen3.7-max'],
  aima:['opus-4.8','gpt-5.6-sol','qwen3.7-max'],
  mk2:['opus-4.8','gpt-5.6-sol','qwen3.7-max'],
  mk46:['qwen3.7-max','opus-4.8','gpt-5.6-sol'],
  'claude-researcher':['gpt-5.6-sol','opus-4.8','qwen3.7-max'],
};
// CHAIN_MODEL_KEYS(short→fullname): 优先用生成的 AGENT_CHAIN_KEYS（single source of truth，
// 由 gen-agent-chains.py 从 openclaw.json 推导），JSON 缺失/损坏时回退硬编码 literal（可能过时）。
const CHAIN_MODEL_KEYS = AGENT_CHAIN_KEYS || {
  'opus-4.8':'aigw-claude-48-main/claude-opus-4-8',
  'fable-5':'aigw-claude-48-main/claude-fable-5',
  'gpt-5.5':'azure-openai-responses/gpt-5.5',
  'gpt-5.6-sol':'azure-openai-responses/gpt-5.6-sol-2026-07-09',
  'qwen3.7-max':'qwen/qwen3.7-max',
  'sonnet-4.6':'anthropic/claude-sonnet-4-6',
};
const CARD_NAME_OVERRIDES={
  main:'钢铁虾 统帅',
  aima:'银月 副翎',
  mk2:'MK2 工程师',
  mk46:'MK46 校官',
};
const chainModelKey = n => CHAIN_MODEL_KEYS[n] || n;
const fmt = n => n.toLocaleString('en-US');
const fmtTok = n => n>=1e9?(n/1e9).toFixed(2)+'B':n>=1e6?(n/1e6).toFixed(1)+'M':fmt(n);
// provider(端点)简称：用于卡片底部区分「同名模型、不同 provider」的情况（如两个 claude-opus-4-8）。
const PROVIDER_SHORT={'aigw-claude-48-main':'aigw','azure-claude-48':'azure','azure-claude':'azure','azure-openai-responses':'azure','deepseek':'ds','qwen':'qwen'};
// 从完整 provider/model 列表构建「模型短名 → 用到的 provider 集合」，只有当同一短名跨多个 provider 时才加端点后缀，保持界面干净。
function buildModelLabeler(fullNames){
  const byShort={};
  fullNames.forEach(fn=>{
    const [prov,mdl]=fn.includes('/')?[fn.slice(0,fn.indexOf('/')),fn.slice(fn.indexOf('/')+1)]:['',fn];
    (byShort[mdl]=byShort[mdl]||new Set()).add(prov);
  });
  return fn=>{
    const [prov,mdl]=fn.includes('/')?[fn.slice(0,fn.indexOf('/')),fn.slice(fn.indexOf('/')+1)]:['',fn];
    if((byShort[mdl]||new Set()).size>1){
      const tag=PROVIDER_SHORT[prov]||prov;
      return tag?mdl+' ('+tag+')':mdl; // 裸名（无 provider）不加空括号
    }
    return mdl;
  };
}
// MISSION QUEUE 倒计时：纯前端用绝对时间戳算，零 token。soon=24h 内高亮金色
function mqCountdown(nextMs){
  if(!nextMs) return {txt:'\u2014', soon:false};
  const diff = nextMs - Date.now();
  if(diff <= 0) return {txt:'now', soon:true};
  const mins = diff/60000;
  if(mins < 60) return {txt:Math.max(1,Math.round(mins))+'m', soon:true};
  const hrs = mins/60;
  if(hrs < 24) return {txt:Math.round(hrs)+'h', soon:true};
  const days = hrs/24;
  return {txt:Math.round(days)+'d', soon:false};
}
// 每 30s 刷新页面上所有 [data-next] 倒计时（仍纯前端，不调任何 API）
function mqTick(){
  document.querySelectorAll('td.tnext[data-next]').forEach(el=>{
    const ms = parseInt(el.getAttribute('data-next')||'0',10);
    const r = mqCountdown(ms);
    el.textContent = r.txt;
    el.classList.toggle('soon', r.soon);
  });
}
setInterval(mqTick, 30000);

// 钢铁侠方舟反应堆 SVG：外金属大环 + 24齿刻度环 + 8段旋转线圈 + 内发光圆盘 + 中心三角核 + 中心白光点
function reactorSvg(ac,lit,id){
  let coils='';
  for(let k=0;k<8;k++){const a=k*45*Math.PI/180;coils+='<line x1="'+(50+Math.cos(a)*22).toFixed(1)+'" y1="'+(50+Math.sin(a)*22).toFixed(1)+'" x2="'+(50+Math.cos(a)*30).toFixed(1)+'" y2="'+(50+Math.sin(a)*30).toFixed(1)+'" stroke="'+lit+'" stroke-width="3" stroke-linecap="round"/>';}
  let ticks='';
  for(let k=0;k<24;k++){const a=k*15*Math.PI/180;ticks+='<line x1="'+(50+Math.cos(a)*33).toFixed(1)+'" y1="'+(50+Math.sin(a)*33).toFixed(1)+'" x2="'+(50+Math.cos(a)*37).toFixed(1)+'" y2="'+(50+Math.sin(a)*37).toFixed(1)+'" stroke="'+ac+'" stroke-width="1.2"/>';}
  return '<svg viewBox="0 0 100 100"><defs><radialGradient id="g'+id+'" cx="50%" cy="50%" r="50%"><stop offset="0%" stop-color="#fff"/><stop offset="28%" stop-color="'+lit+'"/><stop offset="70%" stop-color="'+lit+'" stop-opacity=".25"/><stop offset="100%" stop-color="'+lit+'" stop-opacity="0"/></radialGradient></defs><circle class="metal" cx="50" cy="50" r="40" fill="#070c11" stroke="'+ac+'" stroke-width="3"/><g class="metal">'+ticks+'</g><circle class="metal" cx="50" cy="50" r="33" fill="none" stroke="'+ac+'" stroke-width="1.5" opacity=".7"/><g class="core ring-rot">'+coils+'</g><circle class="core" cx="50" cy="50" r="21" fill="url(#g'+id+')"/><circle class="metal" cx="50" cy="50" r="21" fill="none" stroke="'+ac+'" stroke-width="2"/><path class="core" d="M50 36 L62 58 L38 58 Z" fill="'+lit+'" stroke="#fff" stroke-width="1.2" stroke-linejoin="round"/><circle class="core" cx="50" cy="50" r="5" fill="#fff"/></svg>';
}

// === Event Ticker 跑马灯 ===
let tickerEvents = [];
const EVENTS_URLS = [
  LIVE_URL.replace(/dashboard\.json$/, 'events.json'),
  FALLBACK_URL.replace(/dashboard-fallback\.json$/, 'events.json'),
];
async function loadTicker(){
  try {
    let j = null;
    for(const url of EVENTS_URLS){
      try{
        const r = await fetch(url + '?t=' + Date.now(), {cache:'no-store'});
        if(r.ok){ j = await r.json(); break; }
      }catch(_){ /* try next source */ }
    }
    if(!j) return;
    const priority = {FALLBACK:0, ALERT:1, QC:2, DEPLOY:3};
    tickerEvents = (j.events || [])
      .sort((a,b)=>{
        const ta=String(a.tag||'').toUpperCase(), tb=String(b.tag||'').toUpperCase();
        const pa=priority[ta] ?? 9, pb=priority[tb] ?? 9;
        return pa===pb ? String(b.ts||'').localeCompare(String(a.ts||'')) : pa-pb;
      });
    if(tickerEvents.length===0) return;
    const stream = document.getElementById('tickerStream');
    if(!stream) return;
    const items = [];
    const tagClass = {QC:'qc',DEPLOY:'deploy',FALLBACK:'fallback',ALERT:'alert',CRON:'qc',DEPLOY_ROLLBACK:'fallback'};
    for(const e of tickerEvents){
      const tc = tagClass[e.tag] || 'qc';
      const time = (e.ts||'').replace(/^2026-0?6?-?0?/, '').replace(/T/, ' ').slice(0,11).trim();
      const tag = String(e.tag || '').toUpperCase();
      const msg = String(e.msg || '').toUpperCase();
      items.push(`<span class="event-item"><span class="ev-time">${time}</span><span class="ev-tag ${tc}">${tag}</span><span class="ev-msg">${msg}</span></span>`);
    }
    // 单行跑马灯：标题+内容一起滚，无缝循环 = 内容 × 2
    const html = items.join('') + items.join('');
    stream.innerHTML = html;
    // 计算滚动宽度（内容一半 = 一轮循环）
    const w = stream.scrollWidth / 2;
    stream.style.setProperty('--scroll-end', `-${w}px`);
    // 速度自适应：每轮约 45-110 秒，按字符数调整（介于初版与慢速版之间）
    const totalLen = tickerEvents.reduce((s,e)=>s+e.msg.length+15,0);
    const dur = Math.max(45, Math.min(110, totalLen * 0.18));
    stream.style.setProperty('--scroll-dur', dur+'s');
  }catch(_){ /* ticker 失败静默，不阻塞 dashboard */ }
}

function render(DATA){
  const agentCount = Object.values(DATA.agents || {}).length;
  // 动态链路：从各 agent 的 active_model 算出当前实际在用的 ep-id（反映 fallback 状态）。
  _archActiveEp = {};
  Object.entries(DATA.agents || {}).forEach(([id,a])=>{
    const ep = ARCH_MODEL_EP[a && a.active_model];
    if(ep) _archActiveEp[id] = ep;   // 未映射(如 deepseek)则不写，drawArchLines 回退画配置 primary
  });
  document.getElementById('ts').textContent = '⟦ '+DATA.generated_at+' ⟧';
  document.getElementById('suitsMonitored').textContent = '◉ J.A.R.V.I.S. ONLINE · '+agentCount+' SUITS MONITORED';
  document.getElementById('gen').textContent = DATA.generated_at;
  const g=DATA.grand;
  const summary = [
    {k:'TODAY TOKENS',v:fmtTok(g.today_tok||0),u:'',c:'',sub:'累计 '+fmtTok(g.tok||0)+' tok'},
    {k:'TODAY COST',v:'$'+(g.today_cost||0).toFixed(2),u:'USD',c:'g',sub:'累计 $'+(g.cost||0).toFixed(2)+' · '+fmt(g.calls||0)+' calls'},
    {k:'CACHE SAVINGS',v:'$'+(g.today_save||0).toFixed(2),u:'USD',c:'a',sub:'累计 $'+Math.round(g.save||0)+' total'},
    {k:'ACTIVE SUITS',v:Object.values(DATA.agents).filter(a=>a.status==='ONLINE').length+'/'+Object.values(DATA.agents).length,u:'',c:'',sub:Object.values(DATA.agents).filter(a=>a.status==='IDLE').length+' idle · '+Object.values(DATA.agents).filter(a=>a.status==='OFFLINE').length+' offline'},
  ].map(s=>`<div class="stat ${s.c}"><div class="k">${s.k}</div><div class="v">${s.v} <span class="u">${s.u}</span></div><div class="sub">${s.sub}</div></div>`).join('');

  // 近 7 天趋势：柱状 + 曲线叠加 + per-agent breakdown tooltip
  const tr=DATA.trend||[];
  const N=tr.length||1;
  const maxTrendCost=Math.max(1,...tr.map(t=>t.cost||0));
  const trendBars=tr.map((t,i)=>{
    const h=((t.cost||0)/maxTrendCost*100).toFixed(0);
    const dd=t.date.slice(5);
    const isToday=t.date===DATA.today;
    // breakdown HTML
    const bd=Object.values(t.by_agent||{}).sort((a,b)=>b.tok-a.tok).map(a=>
      `<div class="bd-row"><span class="bd-n">${a.emoji} ${a.name}</span><span class="bd-t">${fmtTok(a.tok)}</span><span class="bd-c">$${a.cost.toFixed(2)}</span></div>`).join('')
      || '<div class="bd-row" style="color:var(--dim)">no activity</div>';
    return `<div class="tbar-wrap" data-i="${i}">
      <div class="tbar ${isToday?'today':''}" style="height:${Math.max(4,h)}%"><div class="tbar-val">$${Math.round(t.cost)}</div></div>
      <div class="tbar-day">${dd}</div>
      <div class="bd-tip"><div class="bd-date">${t.date}${isToday?' · TODAY':''}</div>${bd}<div class="bd-tot">总计 ${fmtTok(t.tok)} · $${t.cost.toFixed(2)}</div></div>
    </div>`;
  }).join('');
  // SVG 曲线占位（用 pixel viewBox，render 后由 drawTrendCurve() 读真实柱顶坐标绘制，保证 100% 对齐）
  const svgCurve=`<svg class="trend-curve" preserveAspectRatio="none"><path class="tline"/><g class="tdots"></g></svg>`;
  const trendBlock=`<section class="trend-sec"><div class="trend-head">7-DAY POWER TREND · 近7天趋势 <span class="trend-sum">近7日 ${fmtTok(g.last7d_tok||0)} tok · $${(g.last7d_cost||0).toFixed(2)}</span></div><div class="trend-chart">${svgCurve}${trendBars}</div></section>`;

  const maxTok = Math.max(...Object.values(DATA.agents).map(a=>a.total_tok));
  // 汇总全站出现过的完整 provider/model，用于同名端点区分（卡片底部 ⚡ 与 FALLBACK 表口径一致）。
  const _allNames=new Set();
  Object.values(DATA.agents).forEach(a=>(a.models||[]).forEach(m=>_allNames.add(m.name)));
  (DATA.models||[]).forEach(m=>_allNames.add(m.name));
  const modelLabel=buildModelLabeler([..._allNames]);
  const suits = Object.entries(DATA.agents).map(([aid,a],idx)=>{
    const st=a.status.toLowerCase();
    const idle = a.idle_min==null?'—':(a.idle_min<60?a.idle_min+'m ago':a.idle_min<1440?Math.round(a.idle_min/60)+'h ago':Math.round(a.idle_min/1440)+'d ago');
    const pct=(a.total_tok/maxTok*100).toFixed(0);
    // 全量展示该 agent 用过的所有模型（含 fable-5 等小用量模型），按 tok 降序，不再截断前3。
    const mdls=(a.models||[]).map(m=>modelLabel(m.name)+' <span>'+fmtTok(m.tok)+'</span>').join('  ·  ')||'—';
    const cardName=CARD_NAME_OVERRIDES[aid]||a.name;
    return `<div class="suit ${st}">
      <div class="suit-head">
        <div class="reactor ${st}" style="--ac:${a.ac||'#888'};--glow:${(a.lit||'#7fdfff')}55">${reactorSvg(a.ac||'#888', a.lit||'#7fdfff', aid||idx)}</div>
        <div class="suit-id"><div class="mark">${a.mark}</div><div class="nm">${cardName}</div><div class="role">${a.role}</div></div>
        <div class="badge ${st}">● ${a.status}</div>
      </div>
      <div class="suit-grid">
        <div class="cell"><div class="lbl">POWER</div><div class="val gold">${fmtTok(a.today_tok||0)} / ${fmtTok(a.total_tok||0)}</div></div>
        <div class="cell"><div class="lbl">FUEL BURN</div><div class="val">$${(a.today_cost||0).toFixed(2)} / $${(a.cost||0).toFixed(2)}</div></div>
        <div class="cell"><div class="lbl">REACTOR EFF.</div><div class="val arc">${a.today_cache_eff||0}% / ${a.cache_eff||0}%</div></div>
        <div class="cell"><div class="lbl">Last Active</div><div class="val" style="font-size:13px">${idle}</div></div>
        <div class="pwr"><div class="lbl" style="font-size:9px;color:var(--dim)">POWER LEVEL</div><div class="bar"><div class="fill" style="width:${pct}%"></div></div></div>
        <div class="models-mini">⚡ ${mdls}</div>
      </div>
    </div>`;
  }).join('');

  const models = [...DATA.models].sort((a,b)=>(b.cost||0)-(a.cost||0)).map(m=>
    `<tr><td class="mdl">${m.name}</td><td class="r">${fmt(m.calls)}</td><td class="r">${fmtTok(m.tok)}</td><td class="r" style="color:var(--gold)">$${m.cost.toFixed(2)}</td></tr>`
  ).join('');

  // ===== MISSION QUEUE · 任务序列 =====
  const AG_LABEL = { main:'MAIN', mk2:'MK2' };
  const crons = Array.isArray(DATA.crons) ? DATA.crons : [];
  const mqRows = crons.map(c=>{
    const st = (c.last_status||'').toLowerCase();
    const enabled = c.enabled !== false;
    let dotCls='idle', stTxt='IDLE', stCls='idle';
    if(!enabled){ dotCls='idle'; stTxt='OFF'; stCls='idle'; }
    else if(st==='ok'){ dotCls='ok'; stTxt='OK'; stCls='ok'; }
    else if(st==='error'){ dotCls='err'; stTxt='ERR'; stCls='err'; }
    else if(st==='skipped'){ dotCls='idle'; stTxt='SKIP'; stCls='idle'; }
    const star = c.core ? '<span class="star">\u2605</span>' : '';
    const ag = AG_LABEL[c.agent] || _esc(String(c.agent||'').toUpperCase());
    const freqEn = _esc(String(c.human_en || c.expr || '').toUpperCase());
    const nameUp = _esc(String(c.name||'').toUpperCase());
    const nextMs = c.next_run_ms || 0;
    const nx = mqCountdown(nextMs);
    // 精读候选 cron：可点击弹出全链路流程图
    const hasFlow = c.name === 'ai-daily-reads-candidates';
    const flowAttr = hasFlow ? ' class="has-flow" onclick="flowOpen()" title="点击查看精读→播客全链路流程"' : (c.core?' class="core"':'');
    return `<tr${flowAttr}>`+
      `<td><span class="tname"><span class="tdot ${dotCls}"></span>${star}<span class="nm">${nameUp}${hasFlow?'<span class="flow-badge">FLOW</span>':''}</span><span class="ag">${ag}</span></span><span class="tfreq">${freqEn}</span></td>`+
      `<td class="r tnext${nx.soon?' soon':''}" data-next="${nextMs}">${nx.txt}</td>`+
      `<td class="r"><span class="tst ${stCls}">${stTxt}</span></td>`+
    `</tr>`;
  }).join('');

  const chain = Object.entries(DATA.agents).map(([id,a])=>{
    const ch=CHAINS[id]||[];
    const active=a.active_model;
    const activeIdx=ch.findIndex(n=>chainModelKey(n)===active);
    const yellowIdx=activeIdx>=0?activeIdx:0;
    const nodes=ch.map((n,i)=>`<span class="node ${i===yellowIdx?'primary':'fb'}">${n}</span>`).join('<span class="arr">▸</span>');
    return `<div class="agent-row"><span class="who">${a.mark} · ${a.name}</span>${nodes}</div>`;
  }).join('');

  // ===== CAPABILITY MATRIX =====
  const cap = DATA.capabilities || null;
  let capMatrix = '';
  if(cap && cap.domains && cap.domains.length){
    window._CAP_DOMAINS = cap.domains;
    const maxTotal = Math.max(1, ...cap.domains.map(d=>d.total));
    const rows = cap.domains.map((d,i)=>{
      const filled = Math.max(1, Math.round(d.total/maxTotal*10));
      const bar = Array.from({length:10},(_,k)=>`<i class="${k<filled?'on':'off'}"></i>`).join('');
      return `<button class="cap-row" onclick="capOpen(${i})">`+
        `<span class="cr-name">${_esc(d.domain)}</span>`+
        `<span class="cr-bar">${bar}</span>`+
        `<span class="cr-num">${d.total}</span>`+
        `<span class="cr-ws">${d.ws}<small>WS</small></span>`+
        `<span class="cr-st"></span>`+
        `<span class="cr-arrow">\u25B8</span></button>`;
    }).join('');
    capMatrix = `<div class="capcard">`+
      `<div class="cap-head"><h2 class="sec cap-sec">SKILL MATRIX · 技能矩阵</h2>`+
        `<span class="cap-stat"><span class="ca"><b>${cap.total}</b>TOTAL</span><span><b style="color:#e6edf6">${cap.ndomains}</b>DOMAINS</span><span class="ca"><b>${cap.ws_scoped}</b>WS</span><span class="cg"><b>${cap.shared}</b>SHARED</span></span>`+
      `</div>`+
      `<div class="cap-list">${rows}</div>`+
      `<div class="cap-legend"><span class="ld"></span><b>BAR</b> RELATIVE SCALE &nbsp;\u00b7&nbsp; <b style="color:var(--gold)">GOLD#</b> TOTAL SKILLS &nbsp;\u00b7&nbsp; <b>BLUE WS</b> WORKSPACE-SCOPED &nbsp;\u00b7&nbsp; <span class="ldot"></span><b>GREEN</b> ONLINE &nbsp;\u00b7&nbsp; CLICK A ROW TO EXPAND \u00b7 WORKSPACE-SCOPED FIRST, SHARED COLLAPSED \u00b7 AUTO-REFRESHED ON INSTALL/REMOVE</div>`+
    `</div>`;
  }

  // ===== AGENT TOPOLOGY · 调度架构 =====
  const _agName = aid => (CARD_NAME_OVERRIDES[aid] || (DATA.agents[aid] && DATA.agents[aid].name) || aid);
  // 窄屏紧凑徽章：短代号 + 短职能 + 中文名（桌面不用，仅 ≤768px 显示）
  const ARCH_CODE = { main:'MK1', aima:'PA', mk2:'MK2', mk46:'MK46', 'claude-researcher':'MK51' };
  const ARCH_SHORTROLE = { main:'ORCHESTRATOR', aima:'ASSISTANT', mk2:'ENGINEER', mk46:'QC', 'claude-researcher':'SENTINEL' };
  const ARCH_SHORTNM = { main:'统帅', aima:'副翎', mk2:'工程师', mk46:'校官', 'claude-researcher':'哨兵' };
  function _archNode(aid, cls){
    const a = DATA.agents[aid]; if(!a) return '';
    const st = (a.status||'').toLowerCase();
    const on = st!=='offline' && st!=='off';
    const role = String(a.role||'').toUpperCase();
    const roleHtml = _esc(role).replace(/ /,'<br>'); // 先转义再插 <br>（首个空格处断行）
    const _rawColor = a.lit || a.ac || '#9fe8ff';
    const markColor = /^#[0-9a-fA-F]{3,8}$/.test(_rawColor) ? _rawColor : '#9fe8ff'; // 仅放行 hex 色值
    const direct = cls==='worker' ? '<span class="arch-direct">DIRECT</span>' : '';
    const code = _esc(ARCH_CODE[aid] || a.mark || aid);
    const srole = _esc(ARCH_SHORTROLE[aid] || role.split(' ')[0]);
    const snm = _esc(ARCH_SHORTNM[aid] || _agName(aid));
    // 桌面形态 (.arch-full) 与 窄屏形态 (.arch-mini) 同时输出，CSS 控显隐
    return `<div class="arch-node ${cls}" id="arch-${aid}">${direct}`+
      `<div class="arch-full">`+
        `<div class="arch-mark" style="color:${markColor}">${_esc(a.mark||'')}</div>`+
        `<div class="arch-nm">${_esc(_agName(aid))}</div>`+
        `<div class="arch-role"><span class="arch-rlabel">${roleHtml}</span>`+
          `<span class="arch-st"><span class="arch-stdot ${on?'on':'off'}"></span>${_esc(a.status||'')}</span></div>`+
      `</div>`+
      `<div class="arch-mini">`+
        `<span class="mb-st ${on?'on':'off'}"></span>`+
        `<div class="mb-code" style="color:${markColor}">${code}</div>`+
        `<div class="mb-role">${srole}</div>`+
        `<div class="mb-nm">${snm}</div>`+
      `</div>`+
    `</div>`;
  }
  const _t1 = ['main','aima'].filter(id=>DATA.agents[id]);
  const _t2 = ['mk2','mk46','claude-researcher'].filter(id=>DATA.agents[id]);
  const archTopology = (_t1.length && _t2.length) ? `
    <div class="arch-card">
      <div class="arch-head">
        <span class="arch-title">AGENT TOPOLOGY · 调度与模型链路</span>
        <span class="arch-legend">
          <span class="alg"><span class="aln solid"></span> MAIN 调度</span>
          <span class="alg"><span class="aln dot"></span> 银月 调度</span>
          <span class="alg"><span class="aln ep"></span> 在用 实线</span>
          <span class="alg"><span class="aln epfb"></span> 备用 点线</span>
          <span class="alg"><span class="adot"></span> 健康</span>
        </span>
      </div>
      <div class="arch-topo" id="archTopo">
        <svg class="arch-lines" id="archLines"></svg>
        <div class="arch-tier t1">${_t1.map(id=>_archNode(id,'orch')).join('')}</div>
        <div class="arch-tier t2">${_t2.map(id=>_archNode(id,'worker')).join('')}</div>
        <div class="arch-tier t3">
          <span class="tts-badge"><span class="ttsd"></span>TTS</span>
          <div class="ep-node healthy" id="ep-opus">
            <div class="ep-full"><div class="epn-top"><span class="epn-dot healthy"></span><span class="epn-llm">OPUS48</span><span class="epn-tag">CLAUDE</span></div><div class="epn-eps"><div class="epn-ep"><span class="eed on"></span><span class="eec">AIGW</span><span class="ees">PRIMARY</span></div><div class="epn-ep sb"><span class="eed sb"></span><span class="eec">CL48</span><span class="ees">STANDBY</span></div></div></div>
            <div class="ep-mini"><div class="em-dot healthy"></div><div class="em-llm">OPUS48</div><div class="em-ep">AIGW·CL48</div></div>
          </div>
          <div class="ep-node healthy" id="ep-gpt">
            <div class="ep-full"><div class="epn-top"><span class="epn-dot healthy"></span><span class="epn-llm">GPT56</span><span class="epn-tag">AZURE</span></div><div class="epn-eps"><div class="epn-ep"><span class="eed on"></span><span class="eec">ACAI</span><span class="ees">ONLINE</span></div></div></div>
            <div class="ep-mini"><div class="em-dot healthy"></div><div class="em-llm">GPT56</div><div class="em-ep">ACAI</div></div>
          </div>
          <div class="ep-node healthy" id="ep-qwen">
            <div class="ep-full"><div class="epn-top"><span class="epn-dot healthy"></span><span class="epn-llm">QWEN37</span><span class="epn-tag">ALI</span></div><div class="epn-eps"><div class="epn-ep"><span class="eed on"></span><span class="eec">DASH</span><span class="ees">ONLINE</span></div></div></div>
            <div class="ep-mini"><div class="em-dot healthy"></div><div class="em-llm">QWEN37</div><div class="em-ep">DASH</div></div>
          </div>
          <div class="ep-node healthy" id="ep-fable">
            <div class="ep-full"><div class="epn-top"><span class="epn-dot healthy"></span><span class="epn-llm">FABLE5</span><span class="epn-tag">CLAUDE</span></div><div class="epn-eps"><div class="epn-ep"><span class="eed on"></span><span class="eec">AIGW</span><span class="ees">ONLINE</span></div></div></div>
            <div class="ep-mini"><div class="em-dot healthy"></div><div class="em-llm">FABLE5</div><div class="em-ep">AIGW</div></div>
          </div>
        </div>
      </div>
    </div>` : '';

  document.getElementById('app').innerHTML = `
    <section class="summary">${summary}</section>
    ${trendBlock}
    <div id="nav-topo" style="height:0"></div>${archTopology}
    <h2 class="sec" id="nav-suits">SUIT STATUS · 战甲编队</h2>
    <section class="suits">${suits}</section>
    <div class="toprow" id="nav-skills">
      ${capMatrix}
      <div class="panel" id="nav-fallback">
        <h2 class="sec">FALLBACK SYSTEMS · 模型备用链路</h2>
        <div class="chain">${chain}</div>
      </div>
    </div>
    <div class="toprow">
      <div class="panel mq" id="nav-cron">
        <h2 class="sec">CRON QUEUE · 定时任务</h2>
        <table><thead><tr><th>TASK</th><th class="r">NEXT</th><th class="r">LAST</th></tr></thead><tbody>${mqRows}</tbody></table>
      </div>
      <div class="panel" id="nav-power">
        <h2 class="sec">POWER CONSUMPTION · 能量消耗</h2>
        <table><thead><tr><th>MODEL</th><th>CALLS</th><th>TOKENS</th><th>COST</th></tr></thead><tbody>${models}</tbody></table>
      </div>
    </div>
    <div class="cap-ov" id="capOv" onclick="capClose()"></div>
    <div class="cap-pop" id="capPop"></div>
    <div class="flow-ov" id="flowOv" onclick="flowClose()"></div>
    <div class="flow-pop" id="flowPop" onclick="flowClose()"><button class="flow-x" onclick="flowClose()" title="关闭">✕</button><img src="/agents/reads-podcast-flow.png?v=3" alt="精读→播客全链路流程" onclick="event.stopPropagation()" /></div>`;

  // 渲染后用真实柱顶坐标绘制趋势曲线（100% 对齐，不受 gap/padding 影响）
  // Topology：首次加载默认激活 MK2；后续数据刷新不覆盖用户当前点击态。
  const archInit = _firstLoad ? 'mk2' : undefined;
  requestAnimationFrame(()=>drawTrendCurve(DATA));
  requestAnimationFrame(()=>{drawArchLines(archInit);bindArchActive();});
  requestAnimationFrame(()=>mqTick());
}

// 点击 agent 节点 → 切换激活态（持久）：该 agent 全链路亮，其余 fallback 暗淡
function _archMarkActive(){
  document.querySelectorAll('.arch-node[id^="arch-"]').forEach(node=>{
    const a=node.id.replace(/^arch-/,'');
    node.classList.toggle('arch-active', a===_archActive);
  });
}
function bindArchActive(){
  const topo=document.getElementById('archTopo'); if(!topo) return;
  topo.querySelectorAll('.arch-node[id^="arch-"]').forEach(node=>{
    const a=node.id.replace(/^arch-/,'');
    node.addEventListener('click',()=>{ drawArchLines(a); _archMarkActive(); });
  });
  _archMarkActive();
}

// ===== AGENT TOPOLOGY 蓝色辉光调度连线 + agent→LLM 链路 =====
// agent → LLM 端点映射（primary 青实线；fallback 青虚线，严格同现网青蓝辉光色系）
// 注：仅 Tier2 worker 的条目会被渲染画 LLM 链路；main/aima(Tier1) 不画 LLM 直连，下方仅供数据完整性/参考
// 优先用 build 时从 openclaw.json 推导的 AGENT_ARCH_EP（与 CHAINS 同一数据源）；
// 若缺失则回退硬编码 literal（仅兜底，可能过时）。
const ARCH_AGENT_EP = AGENT_ARCH_EP || {
  main:                {primary:'ep-fable', fallback:['ep-opus','ep-gpt','ep-qwen']},
  aima:                {primary:'ep-opus', fallback:['ep-gpt','ep-qwen']},
  mk2:                 {primary:'ep-opus', fallback:['ep-gpt','ep-qwen']},
  mk46:                {primary:'ep-qwen', fallback:['ep-opus','ep-gpt']},
  'claude-researcher': {primary:'ep-gpt', fallback:['ep-opus','ep-qwen']},
};
// 持久「当前激活 agent」状态（点击切换）
// 初始='mk2'：默认激活 MK2——二层→三层初始即亮显 MK2 的 primary+fallback 链路；
// 一层 main/银月→LLM 仍隐藏（MK2 是二层非 Tier1，故 main/aima 仍被 B 方案守卫 skip）；
// 其它二层 worker(mk46/claude-researcher) 恒显但暗淡。
let _archActive='mk2';
// Tier1 节点集（模块级常量：B 方案中仅 active 时才画 LLM 链路）
const ARCH_TIER1 = new Set(['main','aima']);
// active_model(provider/model) → 端点 ep-id 映射（动态链路：反映真实 fallback 状态）。
// 同一端点节点可能对应多个 model（如 opus-4.8 / fable-5 同属 Claude/AIGW 节点 ep-opus）。
// deepseek 暂不处理（不映射，落配置链外时回退画配置 primary 实线）。
const ARCH_MODEL_EP = {
  'aigw-claude-48-main/claude-opus-4-8':'ep-opus',
  'aigw-claude-48-main/claude-fable-5':'ep-fable',
  'azure-claude-48/claude-opus-4-8':'ep-opus',
  'azure-claude/claude-opus-4-7':'ep-opus',
  'anthropic/claude-sonnet-4-6':'ep-opus',
  'azure-openai-responses/gpt-5.5':'ep-gpt',
  'azure-openai-responses/gpt-5.6-sol-2026-07-09':'ep-gpt',
  'qwen/qwen3.7-max':'ep-qwen',
};
// 运行时「各 agent 当前实际在用的 ep-id」映射，由 render(DATA) 从 active_model 填充。
let _archActiveEp = {};
function drawArchLines(setActive){
  if(setActive!==undefined && setActive!==null) _archActive=setActive;
  const activeAgent=_archActive;
  const svg=document.getElementById('archLines');
  const topo=document.getElementById('archTopo');
  if(!svg||!topo) return;
  const R=topo.getBoundingClientRect();
  if(!R.width) return;
  svg.setAttribute('viewBox',`0 0 ${R.width} ${R.height}`);
  const c=id=>{const el=document.getElementById('arch-'+id); if(!el) return null; const r=el.getBoundingClientRect();
    return {cx:r.left-R.left+r.width/2, top:r.top-R.top, bot:r.top-R.top+r.height};};
  const cEp=id=>{const el=document.getElementById(id); if(!el) return null; const r=el.getBoundingClientRect();
    return {cx:r.left-R.left+r.width/2, top:r.top-R.top, bot:r.top-R.top+r.height};};
  const main=c('main'), aima=c('aima');
  const workers=['mk2','mk46','claude-researcher'].map(c).filter(Boolean);
  const pathD=(x1,y1,x2,y2)=>{const my=(y1+y2)/2;return `M${x1},${y1} C${x1},${my} ${x2},${my} ${x2},${y2}`;};
  // 自适应：窄屏(≤768px)用更细的连线 + 更小的偏移/端点
  const M = window.matchMedia && window.matchMedia('(max-width:768px)').matches;
  // mOff/aOff = 源端(编排者底部)偏移；mDst/aDst = 宜端(worker 顶部)偏移。桌面保持原始：src14/dst16
  const P = M
    ? {mOff:6, mDst:8, mHalo:4, mCore:1.3, mFlowW:1.3, mFlowDash:'1.6 18', mFlowTo:-19.6, mEnd:2.4, mEndIn:1.1, mStart:2.5, mStartIn:1.2,
       aOff:6, aDst:8, aHalo:3, aCore:2.2, aDash:'0.1 6', aTo:-12.2, aEnd:2, aEndIn:0.9, aStart:2.1, aStartIn:1, blur:2.5, glow:1.2}
    : {mOff:14, mDst:16, mHalo:7, mCore:2, mFlowW:2, mFlowDash:'2 22', mFlowTo:-24, mEnd:3.4, mEndIn:1.6, mStart:3.6, mStartIn:1.7,
       aOff:14, aDst:16, aHalo:5, aCore:3, aDash:'0.1 8', aTo:-16, aEnd:2.8, aEndIn:1.3, aStart:3, aStartIn:1.4, blur:3.5, glow:1.6};
  let halo='',core='',flow='',ends='',starts='';
  // 调度链（Tier1→Tier2）恒亮，与 agent→LLM 激活状态无关
  if(main){
    workers.forEach((w,i)=>{
      const d=pathD(main.cx-P.mOff,main.bot,w.cx-P.mDst,w.top);
      halo+=`<path d="${d}" fill="none" stroke="#00E5FF" stroke-width="${P.mHalo}" opacity="0.22" filter="url(#aBlur)"/>`;
      core+=`<path d="${d}" fill="none" stroke="url(#aGradMain)" stroke-width="${P.mCore}" opacity="0.95" filter="url(#aGlow)"/>`;
      flow+=`<path d="${d}" fill="none" stroke="#dffbff" stroke-width="${P.mFlowW}" stroke-linecap="round" stroke-dasharray="${P.mFlowDash}" opacity="0.9"><animate attributeName="stroke-dashoffset" from="0" to="${P.mFlowTo}" dur="${0.9+i*0.12}s" repeatCount="indefinite"/></path>`;
      ends+=`<circle cx="${w.cx-P.mDst}" cy="${w.top}" r="${P.mEnd}" fill="#00E5FF" filter="url(#aGlow)"/><circle cx="${w.cx-P.mDst}" cy="${w.top}" r="${P.mEndIn}" fill="#eafdff"/>`;
    });
    starts+=`<circle cx="${main.cx-P.mOff}" cy="${main.bot}" r="${P.mStart}" fill="#00E5FF" filter="url(#aGlow)"/><circle cx="${main.cx-P.mOff}" cy="${main.bot}" r="${P.mStartIn}" fill="#eafdff"/>`;
  }
  if(aima){
    workers.forEach((w,i)=>{
      const d=pathD(aima.cx+P.aOff,aima.bot,w.cx+P.aDst,w.top);
      halo+=`<path d="${d}" fill="none" stroke="#2f8fd0" stroke-width="${P.aHalo}" opacity="0.16" filter="url(#aBlur)"/>`;
      core+=`<path d="${d}" fill="none" stroke="url(#aGradAima)" stroke-width="${P.aCore}" stroke-linecap="round" stroke-dasharray="${P.aDash}" opacity="0.95" filter="url(#aGlow)"><animate attributeName="stroke-dashoffset" from="0" to="${P.aTo}" dur="${1.8+i*0.2}s" repeatCount="indefinite"/></path>`;
      ends+=`<circle cx="${w.cx+P.aDst}" cy="${w.top}" r="${P.aEnd}" fill="#48b4ec" filter="url(#aGlow)"/><circle cx="${w.cx+P.aDst}" cy="${w.top}" r="${P.aEndIn}" fill="#cdeeff"/>`;
    });
    starts+=`<circle cx="${aima.cx+P.aOff}" cy="${aima.bot}" r="${P.aStart}" fill="#48b4ec" filter="url(#aGlow)"/><circle cx="${aima.cx+P.aOff}" cy="${aima.bot}" r="${P.aStartIn}" fill="#cdeeff"/>`;
  }

  // ---- agent → LLM 链路（样式/颜色/动效与 Tier1→Tier2 调度链完全一致）----
  // 复用调度链同一视觉配方：halo(#00E5FF) + core(url(#aGradMain)) + flow(#dffbff 流动动画)。
  // 【动态链路】线型反映真实 fallback 状态：当前实际在用的端点(actEp) = 实线高亮（同 MAIN 调度链）；
  // 其余配置内端点 = 点线暗淡（同银月调度链 dot line）。actEp 由 active_model 映射而来，随数据刷新准实时跟随。
  // 全图仅两种线型：实线(实际在用) + 点线(备用)。
  // B 方案：二层 worker → LLM 恒显（随激活态亮/暗）；一层 main/银月 → LLM 仅在点击该节点(active)时才画，避免画面混乱。
  {
    const pEnd = M ? 1.8 : 2.6, pEndIn = M ? 0.9 : 1.3;
    const fbEnd = M ? 1.2 : 1.6;
    const startR = M ? 1.4 : 2;
    // 亮/暗透明度（与调度链恒亮 0.95/0.9 对齐；非激活暗淡）
    const ON_PRIMARY = 0.95, ON_FB = 0.95, DIM = 0.10;
    // 二层 worker 恒显；一层 main/aima 仅 active 时显示（B 方案，TIER1 见模块级常量）
    ['main','aima','mk2','mk46','claude-researcher'].forEach((a,ai)=>{
      const map=ARCH_AGENT_EP[a]; if(!map) return;
      const an=c(a); if(!an) return;
      const active=(activeAgent===a);
      // 一层节点：非激活时完全不画 LLM 链路（保持静态视图干净）
      if(ARCH_TIER1.has(a) && !active) return;
      // 配置内全部端点（primary 在首）
      const allEps=[map.primary, ...map.fallback];
      // 当前实际在用的端点：取 active_model 映射结果；若为空或落在配置链外(如 deepseek)则回退 primary
      let actEp=_archActiveEp[a];
      if(!actEp || allEps.indexOf(actEp)<0) actEp=map.primary;
      // agent 底部出口点
      starts+=`<circle cx="${an.cx}" cy="${an.bot}" r="${startR}" fill="#00E5FF" filter="url(#aGlow)" opacity="${active?0.85:DIM}"/>`;
      // 逐端点绘制：actEp=实线高亮（当前在用），其余=点线暗淡（备用）
      allEps.forEach((ep,ei)=>{
        const fn=cEp(ep); if(!fn) return;
        const d=pathD(an.cx,an.bot,fn.cx,fn.top);
        const isAct=(ep===actEp);
        if(isAct){
          // 实际在用：复用 MAIN 调度链配方（halo + 实线 core + 流动 flow）
          const po = active?ON_PRIMARY:DIM;
          halo+=`<path d="${d}" fill="none" stroke="#00E5FF" stroke-width="${P.mHalo}" opacity="${active?0.22:0.06}" filter="url(#aBlur)"/>`;
          core+=`<path d="${d}" fill="none" stroke="url(#aGradMain)" stroke-width="${P.mCore}" opacity="${po}" filter="url(#aGlow)"/>`;
          flow+=`<path d="${d}" fill="none" stroke="#dffbff" stroke-width="${P.mFlowW}" stroke-linecap="round" stroke-dasharray="${P.mFlowDash}" opacity="${active?0.9:0.12}"><animate attributeName="stroke-dashoffset" from="0" to="${P.mFlowTo}" dur="${0.9+ai*0.12}s" repeatCount="indefinite"/></path>`;
          ends+=`<circle cx="${fn.cx}" cy="${fn.top}" r="${pEnd}" fill="#00E5FF" filter="url(#aGlow)" opacity="${po}"/><circle cx="${fn.cx}" cy="${fn.top}" r="${pEndIn}" fill="#eafdff" opacity="${po}"/>`;
        }else{
          // 备用：与银月调度链完全同款 dot line（halo + 点状 core 自带流动）
          const fo = active?ON_FB:DIM;
          halo+=`<path d="${d}" fill="none" stroke="#00E5FF" stroke-width="${P.mHalo}" opacity="${active?0.16:0.05}" filter="url(#aBlur)"/>`;
          core+=`<path d="${d}" fill="none" stroke="url(#aGradMain)" stroke-width="${P.aCore}" stroke-linecap="round" stroke-dasharray="${P.aDash}" opacity="${fo}" filter="url(#aGlow)"><animate attributeName="stroke-dashoffset" from="0" to="${P.aTo}" dur="${1.8+ei*0.2}s" repeatCount="indefinite"/></path>`;
          ends+=`<circle cx="${fn.cx}" cy="${fn.top}" r="${fbEnd}" fill="#00E5FF" filter="url(#aGlow)" opacity="${active?ON_FB:DIM}"/>`;
        }
      });
    });
  }

  const defs=`<defs>`+
    `<filter id="aBlur" x="-60%" y="-60%" width="220%" height="220%"><feGaussianBlur stdDeviation="${P.blur}"/></filter>`+
    `<filter id="aGlow" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="${P.glow}" result="b"/><feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge></filter>`+
    `<linearGradient id="aGradMain" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#7fefff"/><stop offset="1" stop-color="#1fb6ff"/></linearGradient>`+
    `<linearGradient id="aGradAima" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#6fd0ff"/><stop offset="1" stop-color="#2f8fd0"/></linearGradient>`+
  `</defs>`;
  svg.innerHTML=defs+halo+core+flow+starts+ends;
}

// ===== CAPABILITY MATRIX 展开面板 =====
function _esc(s){return String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');}
function _capSkillRow(s){
  const ico = s.emoji || '\u25A3';
  const src = s.shared ? '<span class="csk-shared">SHARED</span>'
    : (s.agents||[]).map(a=>`<span class="csk-atag">${_esc(a)}</span>`).join('');
  return `<div class="csk"><div class="csk-ico">${ico}</div>`+
    `<div class="csk-body"><div class="csk-name">${_esc(s.name)}</div><div class="csk-desc">${_esc(s.desc)}</div></div>`+
    `<div class="csk-src">${src}</div></div>`;
}
function capOpen(i){
  const doms = window._CAP_DOMAINS || [];
  const d = doms[i]; if(!d) return;
  const ws = (d.ws_skills||[]).map(_capSkillRow).join('') || '<div class="csk-empty">\u2014 NONE \u2014</div>';
  const shared = (d.shared_skills||[]);
  const sharedBlock = shared.length
    ? `<div class="cap-fold"><button class="cap-foldbtn" onclick="this.parentNode.classList.toggle('open')">+ ${shared.length} SHARED BUNDLED \u25BE</button><div class="cap-foldbody">${shared.map(_capSkillRow).join('')}</div></div>`
    : '';
  const pop = document.getElementById('capPop');
  pop.innerHTML = `<div class="cp-head"><span>${_esc(d.domain)}</span><button class="cp-x" onclick="capClose()">\u2715 CLOSE</button></div>`+
    `<div class="cp-sec">WORKSPACE-SCOPED (${d.ws})</div><div class="cp-grid">${ws}</div>${sharedBlock}`;
  document.getElementById('capOv').classList.add('on');
  pop.classList.add('on');
}
function capClose(){
  const ov=document.getElementById('capOv'); const pop=document.getElementById('capPop');
  if(ov) ov.classList.remove('on');
  if(pop) pop.classList.remove('on');
}
// Astro <script define:vars> 是模块作用域，inline onclick="capOpen(..)" 找不到模块内函数 → 必须挂到 window
window.capOpen = capOpen;
window.capClose = capClose;
// CRON QUEUE 精读行 → 全链路流程图 overlay（点背景/ESC 关闭）
function flowOpen(){
  document.getElementById('flowOv').classList.add('on');
  document.getElementById('flowPop').classList.add('on');
}
function flowClose(){
  const ov=document.getElementById('flowOv'); const pop=document.getElementById('flowPop');
  if(ov) ov.classList.remove('on');
  if(pop) pop.classList.remove('on');
}
window.flowOpen = flowOpen;
window.flowClose = flowClose;
document.addEventListener('keydown',e=>{if(e.key==='Escape'){capClose();flowClose();}});

function drawTrendCurve(DATA){
  const chart=document.querySelector('.trend-chart');
  const svg=document.querySelector('.trend-curve');
  if(!chart||!svg) return;
  const tr=DATA.trend||[];
  const cb=chart.getBoundingClientRect();
  // SVG 覆盖整个 chart，viewBox = chart 像素尺寸，坐标直接用 px
  svg.setAttribute('viewBox',`0 0 ${cb.width} ${cb.height}`);
  svg.style.left='0';svg.style.top='0';svg.style.width='100%';svg.style.height='100%';
  const bars=[...chart.querySelectorAll('.tbar')];
  const pts=bars.map(el=>{
    const r=el.getBoundingClientRect();
    return {x:r.left+r.width/2-cb.left, y:r.top-cb.top};
  });
  // 平滑曲线：Catmull-Rom 转贝塞尔，自然弧度过渡每个节点
  const poly=svg.querySelector('.tline');
  let dPath='';
  if(pts.length>0){
    dPath='M '+pts[0].x.toFixed(1)+' '+pts[0].y.toFixed(1);
    for(let i=0;i<pts.length-1;i++){
      const p0=pts[i-1]||pts[i], p1=pts[i], p2=pts[i+1], p3=pts[i+2]||p2;
      const t=0.16; // 张力，越小越缓
      const c1x=p1.x+(p2.x-p0.x)*t, c1y=p1.y+(p2.y-p0.y)*t;
      const c2x=p2.x-(p3.x-p1.x)*t, c2y=p2.y-(p3.y-p1.y)*t;
      dPath+=' C '+c1x.toFixed(1)+' '+c1y.toFixed(1)+', '+c2x.toFixed(1)+' '+c2y.toFixed(1)+', '+p2.x.toFixed(1)+' '+p2.y.toFixed(1);
    }
  }
  poly.setAttribute('d',dPath);
  const g=svg.querySelector('.tdots');
  g.innerHTML=pts.map((p,i)=>{
    const isToday=(tr[i]&&tr[i].date===DATA.today);
    return `<circle cx="${p.x.toFixed(1)}" cy="${p.y.toFixed(1)}" r="4" class="tdot ${isToday?'today':''}"/>`;
  }).join('');
}
let _trendData=null;
window.addEventListener('resize',()=>{ if(_trendData) drawTrendCurve(_trendData); drawArchLines(); });

// ===== KNOWLEDGE PYRAMID: 实时容量 + Agent 切换 =====
let _kpAgent='main', _kpData=null;
function _kpFmt(t){ if(!t) return '— · —'; const files=`${t.files} FILE${t.files===1?'':'S'}`; return `${t.kb}K · ${files}${t.over?' ⚠':''}`; }
function renderKnowledge(d){
  if(d && d.knowledge) _kpData = d.knowledge;
  if(!_kpData) return;
  const k = _kpData[_kpAgent];
  if(!k) return;
  const s3=document.getElementById('kpStat3'), s2=document.getElementById('kpStat2'), s1=document.getElementById('kpStat1');
  if(!s3) return;
  s3.textContent=_kpFmt(k.t3); s3.classList.toggle('over', !!(k.t3&&k.t3.over));
  s2.textContent=_kpFmt(k.t2); s2.classList.remove('over');
  s1.textContent=_kpFmt(k.t1); s1.classList.remove('over');
  // 数据已到位并成功渲染（此处 _kpData 与 k 必存在），解除初始隐藏，与 #app 内容同一时刻出现
  const _kpc=document.querySelector('.kp-card'); if(_kpc) _kpc.classList.remove('kp-pending');
}
(function(){
  const sw=document.getElementById('kpSwitch');
  if(!sw) return;
  sw.querySelectorAll('.kp-agent').forEach(el=>{
    const act=()=>{ _kpAgent=el.dataset.agent;
      sw.querySelectorAll('.kp-agent').forEach(x=>x.classList.toggle('active', x===el));
      renderKnowledge(null); };
    el.addEventListener('click', act);
    el.addEventListener('keydown', e=>{ if(e.key==='Enter'||e.key===' '){ e.preventDefault(); act(); } });
  });
})();

let _firstLoad=true;
async function tick(){
  try{
    // 优先实时端点；失败则回退静态快照
    let d;
    try{
      d = await (await fetch(LIVE_URL, {cache:'no-store'})).json();
    }catch(err){
      console.warn('[JARVIS] LIVE telemetry unreachable, falling back to static snapshot:', err);
      d = await (await fetch(FALLBACK_URL + '?t=' + Date.now(), {cache:'no-store'})).json();
    }
    _trendData=d; render(d); renderKnowledge(d); loadTicker(); _firstLoad=false;
  }catch(e){
    if(_firstLoad){
      document.getElementById('app').innerHTML='<div class="loading" style="color:var(--red)">⚠ TELEMETRY LINK FAILED · '+e.message+'</div>';
    }
    // 非首次失败：保留上一帧画面，不闪烁
  }
}
// ===== LIGHTHOUSE NODE · 服务器实时指标（/server.json，每 10s，零 token）=====
const SERVER_URL = LIVE_URL.replace(/dashboard\.json$/, 'server.json');
const NSEG_N = 12, NTP_N = 30;
function _nodeSegs(el, total, onCount, cls){
  if(el.childElementCount !== total){ el.innerHTML = Array.from({length:total},()=> '<i></i>').join(''); }
  [...el.children].forEach((c,i)=>{ c.className = i < onCount ? ('on'+(cls&&cls(i)?' '+cls(i):'')) : (cls&&cls(i)?cls(i):''); });
}
function _fmtSpeed(kbps){
  if(kbps >= 1024) return (kbps/1024).toFixed(1)+'<span class="u">MB/s</span>';
  return Math.round(kbps)+'<span class="u">KB/s</span>';
}
function _fmtUp(s){
  const d=Math.floor(s/86400), h=Math.floor(s%86400/3600);
  return d>0 ? d+'d'+String(h).padStart(2,'0')+'h' : h+'h'+String(Math.floor(s%3600/60)).padStart(2,'0')+'m';
}
function _spark(el, arr){
  if(!arr || arr.length<2){ el.setAttribute('points',''); return; }
  const max = Math.max(...arr, 1);
  const pts = arr.map((v,i)=> (i*(52/(arr.length-1))).toFixed(1)+','+(11 - v/max*9).toFixed(1)).join(' ');
  el.setAttribute('points', pts);
}
function _nodeOffline(){
  const strip=document.getElementById('nodeStrip');
  strip.classList.remove('node-pending'); strip.classList.add('offline');
  document.getElementById('nodeLv').innerHTML='LINK LOST · <b>NODE OFFLINE</b>';
}
async function nodeTick(){
  let d;
  try{ d = await (await fetch(SERVER_URL, {cache:'no-store'})).json(); }
  catch(e){ _nodeOffline(); return; }
  if(!d || !d.ok){ _nodeOffline(); return; }
  const strip=document.getElementById('nodeStrip');
  strip.classList.remove('node-pending','offline');
  document.getElementById('nodeLv').innerHTML='UP <b>'+_fmtUp(d.uptime_s)+'</b> · LOAD <b>'+d.load1.toFixed(2)+'</b> · <b>ONLINE</b>';
  document.getElementById('nCpuV').innerHTML=Math.round(d.cpu.pct)+'<span class="u">%</span>';
  _nodeSegs(document.getElementById('nCpuSeg'), NSEG_N, Math.round(d.cpu.pct/100*NSEG_N));
  document.getElementById('nCpuSub').innerHTML='usr <b>'+d.cpu.user+'</b> · sys <b>'+d.cpu.sys+'</b> · io <b>'+d.cpu.io+'</b>';
  document.getElementById('nMemV').innerHTML=Math.round(d.mem.pct)+'<span class="u">%</span>';
  _nodeSegs(document.getElementById('nMemSeg'), NSEG_N, Math.round(d.mem.pct/100*NSEG_N));
  document.getElementById('nMemSub').innerHTML='<b>'+d.mem.used_gb+'/'+d.mem.total_gb+'</b> GB · swap <b>'+(d.mem.swap_used_mb>=1024?(d.mem.swap_used_mb/1024).toFixed(1)+'G':d.mem.swap_used_mb+'M')+'</b>';
  document.getElementById('nDiskV').innerHTML=Math.round(d.disk.pct)+'<span class="u">%</span>';
  _nodeSegs(document.getElementById('nDiskSeg'), NSEG_N, Math.round(d.disk.pct/100*NSEG_N));
  document.getElementById('nDiskSub').innerHTML='<b>'+d.disk.used_gb+'/'+d.disk.total_gb+'</b> GB · free <b>'+d.disk.free_gb+'</b>';
  document.getElementById('nNetUp').innerHTML=_fmtSpeed(d.net.up_kbps);
  document.getElementById('nNetDn').innerHTML=_fmtSpeed(d.net.down_kbps);
  _spark(document.getElementById('nSparkUp'), d.net.spark_up);
  _spark(document.getElementById('nSparkDn'), d.net.spark_down);
  const t=d.traffic;
  if(t && t.total_bytes){
    const usedGB=Math.round(t.used_bytes/1e9), totalGB=Math.round(t.total_bytes/1e9);
    document.getElementById('nTpV').innerHTML=usedGB+'<span class="u">GB</span> / '+totalGB+'<span class="u">GB</span>';
    const onN=Math.min(NTP_N, Math.round(t.pct_used/100*NTP_N));
    _nodeSegs(document.getElementById('nTpSeg'), NTP_N, onN, (i)=> i>=27?'crit':(i>=24?'warn':''));
    document.getElementById('nTpPct').innerHTML=t.pct_used+'% USED · <b style="color:var(--gold)">⧫80%</b> <b style="color:var(--red)">⧫90%</b>';
    const rst=(t.cycle_end||'').slice(5,10).replace('-','-');
    const sync=(t.updated||'').slice(11,16);
    document.getElementById('nTpRst').innerHTML='RST <b>'+rst+'</b> · SYNC <b>'+sync+'</b>';
  }else{
    document.getElementById('nTpV').textContent='NO DATA';
    document.getElementById('nTpPct').textContent='traffic api unsynced';
  }
}

// ===== 访问门：8 位数字锁（纯前端，仅防普通人随手查看）=====
// 未解锁不 fetch 任何数据。解锁后存 localStorage，下次免输。
const _PIN = '11428089';
const _PIN_KEY = 'shrimp_pin_ok';
let _started = false;
function _startDash(){
  if(_started) return; _started = true;
  document.body.classList.remove('gate-locked');
  tick();
  setInterval(tick, 60000);  // 每 60 秒刷新
  nodeTick();
  setInterval(nodeTick, 10000); // LIGHTHOUSE NODE 每 10 秒（纯 JSON，零 token）
}
function _gate(){
  if(localStorage.getItem(_PIN_KEY) === _PIN){ _startDash(); return; }
  document.body.classList.add('gate-locked');
  const app = document.getElementById('app');
  app.innerHTML = `<main class="login-gate" lang="en">
    <div class="login-top"><div class="login-brand">J.A.R.V.I.S. OS</div><div class="login-private-badge">PRIVATE NODE</div></div>
    <div class="login-reactor" aria-hidden="true">
      <svg viewBox="0 0 100 100">
        <defs><radialGradient id="loginGateGlow"><stop offset="0%" stop-color="#fff"/><stop offset="28%" stop-color="#7fdfff"/><stop offset="70%" stop-color="#3fc9ff" stop-opacity=".35"/><stop offset="100%" stop-color="#3fc9ff" stop-opacity="0"/></radialGradient></defs>
        <g class="login-rotor"><circle cx="50" cy="50" r="46" fill="none" stroke="#16384b" stroke-width="2"/><circle cx="50" cy="50" r="39" fill="none" stroke="#ffc400" stroke-width="2.4" stroke-dasharray="4 5"/><circle cx="50" cy="50" r="28" fill="none" stroke="#3fc9ff" stroke-width="3" opacity=".8"/></g>
        <circle cx="50" cy="50" r="18" fill="url(#loginGateGlow)" opacity=".95"/>
        <path class="login-tri" d="M50 64 L65 38 L35 38 Z" fill="#7fdfff" stroke="#fff" stroke-width="1.2"/>
      </svg>
    </div>
    <h1 class="login-title">ACCESS GATE</h1>
    <p class="login-subtitle">Telemetry console locked<br/>Authenticate to boot reactor interface</p>
    <div class="login-terminal"><b>root@jarvis-os</b>: initiating private dashboard handshake<br/><b>auth</b>: enter 8-digit operator code <span class="login-cursor"></span></div>
    <form id="pinForm" class="login-form">
      <label class="login-pin-wrap"><span class="login-prompt">PIN&gt;</span><input id="pinInput" class="login-input" type="password" inputmode="numeric" maxlength="8" placeholder="••••••••" autocomplete="off" /></label>
      <button class="login-btn" type="submit">UNLOCK CONSOLE</button>
      <div id="pinErr" class="login-err"></div>
    </form>
    <div class="login-meta"><span>NOINDEX</span><span>LOCAL SESSION</span><span>v0.5</span></div>
  </main>`;
  const inp = document.getElementById('pinInput');
  inp.focus();
  document.getElementById('pinForm').addEventListener('submit', (e)=>{
    e.preventDefault();
    if(inp.value === _PIN){
      localStorage.setItem(_PIN_KEY, _PIN);
      app.innerHTML = '<div class="loading"><span class="pulse">◉ BOOTING REACTOR · LOADING TELEMETRY...</span></div>';
      _startDash();
    }else{
      document.getElementById('pinErr').textContent = 'ACCESS DENIED · INVALID OPERATOR CODE';
      inp.value=''; inp.focus();
    }
  });
}
_gate();

// ===== HUD QUICK NAV · scrollspy + jump =====
(function(){
  const nav = document.getElementById('hudnav');
  const fab = document.getElementById('hudfab');
  if(!nav) return;
  const btns = Array.from(nav.querySelectorAll('.hn'));
  const isMobile = () => window.matchMedia('(max-width:820px),(max-height:560px)').matches;
  // jump
  btns.forEach(b => b.addEventListener('click', () => {
    const el = document.getElementById(b.dataset.goto);
    if(!el) return;
    el.scrollIntoView({behavior:'smooth', block:'start'});
    if(isMobile() && fab){ nav.classList.remove('open'); fab.classList.remove('open'); }
  }));
  // click-outside dismiss (mobile FAB menu)
  document.addEventListener('pointerdown', (e) => {
    if(!isMobile() || !fab || !nav.classList.contains('open')) return;
    if(!nav.contains(e.target) && !fab.contains(e.target)){
      nav.classList.remove('open'); fab.classList.remove('open');
    }
  }, {passive:true});
  // FAB toggle (portrait / small screens)
  if(fab) fab.addEventListener('click', () => {
    nav.classList.toggle('open');
    fab.classList.toggle('open');
  });
  // scrollspy: highlight the section currently in view (top-most past 40% viewport)
  let ticking = false;
  function spy(){
    ticking = false;
    if(document.body.classList.contains('gate-locked')) return;
    const mark = window.innerHeight * 0.4;
    let best = null, bestTop = -Infinity;
    btns.forEach(b => {
      const el = document.getElementById(b.dataset.goto);
      if(!el) return;
      const top = el.getBoundingClientRect().top;
      if(top <= mark && top > bestTop){ bestTop = top; best = b; }
    });
    if(!best) best = btns[0];
    btns.forEach(b => b.classList.toggle('act', b === best));
  }
  window.addEventListener('scroll', () => { if(!ticking){ ticking = true; requestAnimationFrame(spy); } }, {passive:true});
  window.addEventListener('resize', () => { if(!ticking){ ticking = true; requestAnimationFrame(spy); } }, {passive:true});
  setTimeout(spy, 800); // 首屏渲染后初始高亮
})();
</script>
