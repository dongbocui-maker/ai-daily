---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SectionSprite from '../../components/SectionSprite.astro';
import fs from 'node:fs';
import path from 'node:path';
import '../../styles/sections.css';

// 加载所有 snapshot，按日期排序取最新
const snapshotsDir = path.resolve('./src/data/lmarena/snapshots');
const snapshotFiles = fs.existsSync(snapshotsDir)
  ? fs.readdirSync(snapshotsDir).filter(f => f.endsWith('.json')).sort()
  : [];

const latestFile = snapshotFiles.length > 0 ? snapshotFiles[snapshotFiles.length - 1] : null;
const previousFile = snapshotFiles.length > 1 ? snapshotFiles[snapshotFiles.length - 2] : null;

const latest = latestFile
  ? JSON.parse(fs.readFileSync(path.join(snapshotsDir, latestFile), 'utf-8'))
  : null;
const previous = previousFile
  ? JSON.parse(fs.readFileSync(path.join(snapshotsDir, previousFile), 'utf-8'))
  : null;

// 计算月度对比
type DeltaInfo = { type: 'baseline' | 'new' | 'up' | 'down' | 'same'; delta?: number };
function computeDelta(modelName: string, currentRank: number): DeltaInfo {
  if (!previous) return { type: 'baseline' };
  const prev = previous.models?.find((m: any) => m.name === modelName);
  if (!prev) return { type: 'new' };
  const d = prev.rank - currentRank;
  if (d > 0) return { type: 'up', delta: d };
  if (d < 0) return { type: 'down', delta: Math.abs(d) };
  return { type: 'same' };
}

// 退出 Top 50 的模型（在上月榜单但本月不在）
const exitedModels = previous && latest
  ? previous.models.filter((p: any) => !latest.models.find((c: any) => c.name === p.name))
  : [];

// 厂商分布统计
const orgCounts: Record<string, number> = {};
if (latest) {
  for (const m of latest.models) orgCounts[m.org] = (orgCounts[m.org] || 0) + 1;
}
const orgRanking = Object.entries(orgCounts).sort((a, b) => b[1] - a[1]);

// 单项分区数（categoryLabels 里排除综合类维度后的可比对分区）
const totalShown = latest?.totalModelsShown ?? (latest?.models?.length ?? 0);
const categoryCount = latest?.categoryLabels ? Object.keys(latest.categoryLabels).length : 0;

function splitStat(n: number): { head: string; tail: string } {
  const s = String(n);
  if (s.length <= 1) return { head: '', tail: s };
  return { head: s.slice(0, -1), tail: s.slice(-1) };
}
const shownStat = splitStat(totalShown);
---
<Base title="竞技场" description="基于 LMArena / arena.ai 实测数据的全球大模型 Top 50 排行榜，每月更新一次。">
  <Header />
  <SectionSprite />
  <main class="sec-page" style="--acc:#F59E0B;--acc-deep:#B45309;--acc-ghost:#FDF3E3;--acc-band:#FFFBF2">
    <section class="hero"><div class="wrap">
      <span class="badge"><svg class="ic"><use href="#i-trophy"/></svg>Arena</span>
      <h1>模型<span class="pu">竞技场</span></h1>
      <p class="hero-sub">基于 <a href="https://arena.ai/leaderboard" target="_blank" rel="noopener">arena.ai</a> 真实人类盲测对战数据的全球大模型排行，含总榜与各单项分区，每月 1 日快照留档可回溯。</p>
      {latest && (
        <div class="stats">
          <div class="stat"><b>{shownStat.head}<i>{shownStat.tail}</i></b><span>上榜模型</span></div>
          {categoryCount > 0 && <div class="stat"><b>{categoryCount}</b><span>单项分区</span></div>}
          <div class="stat"><b>月<i>更</i></b><span>快照节奏</span></div>
        </div>
      )}
    </div></section>

    {!latest ? (
      <div class="wrap"><div class="empty"><p>暂无数据。</p></div></div>
    ) : (
      <div class="wrap">
        {/* 厂商分布 */}
        <div class="sec-head">
          <span class="sq"><svg class="ic"><use href="#i-trophy"/></svg></span>
          <div class="tt"><span class="eyebrow">Vendors</span><h2>Top {totalShown} 厂商分布</h2></div>
          <span class="rule"></span><span class="cnt">{orgRanking.length} 家</span>
        </div>
        <div class="chips-row">
          {orgRanking.map(([org, count]) => (
            <span class="org-chip">{org} ×{count}</span>
          ))}
        </div>

        {/* 总榜 */}
        <div class="sec-head">
          <span class="sq"><svg class="ic"><use href="#i-trophy"/></svg></span>
          <div class="tt"><span class="eyebrow">Overall</span><h2>总榜 Top {totalShown}</h2></div>
          <span class="rule"></span>
          <span class="cnt">
            {latest.snapshotDate} 快照
            {latest.isBaseline ? ' · 基线' : ''}
          </span>
        </div>
        <div class="rlist">
          {latest.models.map((m: any) => {
            const delta = computeDelta(m.name, m.rank);
            const pct = Math.max(6, Math.round(((totalShown - m.rank + 1) / totalShown) * 100));
            return (
              <div class={`rank-row ${m.rank <= 3 ? 'top' : ''}`}>
                <span class="rank-num">{m.rank}</span>
                <div class="rank-main">
                  <div class="rank-name">{m.name}</div>
                  <div class="rank-sub">{m.org}</div>
                  <div class="rank-bar"><i style={`width:${pct}%`}></i></div>
                  <div class="rank-tags">
                    {m.highlight.length === 0 ? (
                      <span class="t">综合 #{m.rank}</span>
                    ) : (
                      m.highlight.map((h: any) => (
                        <span class={`t ${h.isTop10 ? 'hot' : ''}`}>{h.label} #{h.rank}</span>
                      ))
                    )}
                  </div>
                </div>
                <span class={`rank-delta ${
                  delta.type === 'up' ? 'up' : delta.type === 'down' ? 'down' :
                  delta.type === 'new' ? 'new' : delta.type === 'baseline' ? 'base' : 'same'
                }`}>
                  {delta.type === 'baseline' && '基线'}
                  {delta.type === 'new' && '新进'}
                  {delta.type === 'up' && `↑${delta.delta}`}
                  {delta.type === 'down' && `↓${delta.delta}`}
                  {delta.type === 'same' && '—'}
                </span>
              </div>
            );
          })}
        </div>

        {/* 退出 Top 50 */}
        {exitedModels.length > 0 && (
          <div class="panel">
            <h3>本月退出 Top {totalShown}（共 {exitedModels.length} 个）</h3>
            <div class="chips-row">
              {exitedModels.map((m: any) => (
                <span class="exit-chip">{m.name} <span style="opacity:.6">上月 #{m.rank}</span></span>
              ))}
            </div>
          </div>
        )}

        {/* 说明 */}
        <div class="panel">
          <h3>说明</h3>
          <p><strong>数据来源</strong>：<a href="https://arena.ai/leaderboard" target="_blank" rel="noopener">arena.ai 官方排行榜</a>，基于全球用户盲测投票。排名为相对位次（rank position），非 ELO 分数。</p>
          <p><strong>优势赛道</strong>：从该模型 27 个评测维度中优先展示进入 Top 10 的核心维度（最多 3 个），不足时用其自身相对最强维度补足。</p>
          <p><strong>月度变化</strong>：与上月快照对比。↑ 上升 / ↓ 下降 / 新进 Top {totalShown} / 基线（首期或上月不在榜）。</p>
          <p><strong>更新频率</strong>：每月 1 日 09:00（北京时间）自动抓取并发布。</p>
        </div>
      </div>
    )}
  </main>
  <Footer />
</Base>
