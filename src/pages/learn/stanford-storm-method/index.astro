---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const docs = await getCollection('claude-code-docs');
const doc = docs.find((d) => d.data.slug === 'stanford-storm-method');
if (!doc) throw new Error('claude-code-docs entry with slug=stanford-storm-method not found');
const { Content } = await render(doc);
const base = import.meta.env.BASE_URL;
---
<Base
  title={doc.data.title}
  description="Stanford STORM（NAACL 2024）的真实机制 + 可复用的四步提示词工作流（多视角 / 矛盾地图 / 综合 / 自检），含官方论文口径核实与本站实践建议。"
>
  <Header />
  <main class="flex-1">
    {/* Hero */}
    <section class="bg-accent-ink text-white relative overflow-hidden">
      <div class="container-x py-12 lg:py-16">
        <nav class="text-xs text-accent-gray-400 mb-4">
          <a href={`${base}learn/`} class="hover:text-accent-purple-light">研修院</a>
          <span class="mx-2">/</span>
          <span class="text-accent-gray-300">{doc.data.title}</span>
        </nav>
        <span class="inline-block bg-accent-purple text-white px-3 py-1 text-[11px] font-semibold tracking-widest uppercase mb-4 rounded-sm">研究方法 · STORM</span>
        <h1 class="text-3xl md:text-4xl lg:text-5xl font-extrabold leading-[1.15] tracking-tight mb-4 max-w-4xl">
          {doc.data.title}
        </h1>
        {doc.data.subtitle && (
          <p class="text-base lg:text-lg text-accent-gray-300 max-w-3xl leading-relaxed mb-6">
            {doc.data.subtitle}
          </p>
        )}
        <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-xs text-accent-gray-400">
          <span>📖 来源：<a href={doc.data.sourceUrl} target="_blank" rel="noopener noreferrer" class="text-accent-purple-light hover:underline">{doc.data.sourceLabel}</a></span>
          <span>·</span>
          <span>🔖 中文导读与事实核对：钢铁虾</span>
          {doc.data.updated && (
            <>
              <span>·</span>
              <span>🗓 更新：{doc.data.updated}</span>
            </>
          )}
        </div>
      </div>
    </section>

    {/* 正文 — markdown 渲染 */}
    <article class="container-x max-w-4xl py-10 prose prose-lg prose-headings:font-bold prose-headings:tracking-tight prose-h1:text-3xl prose-h2:text-2xl prose-h3:text-xl prose-a:text-accent-purple prose-a:no-underline hover:prose-a:underline prose-strong:text-accent-ink prose-table:text-sm prose-table:my-4 prose-th:bg-accent-gray-50 prose-th:font-semibold prose-th:px-3 prose-th:py-2 prose-td:px-3 prose-td:py-2 prose-td:border prose-th:border prose-td:border-accent-gray-200 prose-th:border-accent-gray-200 prose-code:text-accent-purple prose-code:bg-accent-gray-50 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-code:before:content-none prose-code:after:content-none prose-pre:bg-accent-gray-900 prose-pre:text-accent-gray-100 prose-pre:text-[13px] prose-pre:leading-[1.5] prose-blockquote:border-accent-purple prose-blockquote:font-normal prose-blockquote:text-accent-gray-700 prose-hr:border-accent-gray-200">
      <Content />
    </article>

    {/* 底部 */}
    <section class="container-x max-w-4xl pb-16">
      <div class="border-t border-accent-gray-200 pt-8 flex flex-col md:flex-row justify-between gap-4">
        <a href={doc.data.sourceUrl} target="_blank" rel="noopener noreferrer" class="px-5 py-3 border border-accent-gray-300 hover:border-accent-purple hover:text-accent-purple transition text-sm font-semibold text-center">
          📖 阅读英文原文 →
        </a>
        <a href={`${base}learn/`} class="px-5 py-3 border-2 border-accent-purple bg-accent-purple text-white hover:bg-accent-purple-deep transition text-sm font-semibold text-center">
          ⇧ 返回研修院
        </a>
      </div>
    </section>
  </main>
  <Footer />
</Base>

<style is:global>
  /* 提示词卡片 —— 仅本页使用，样式局限在 .storm-prompt 内，不影响全局组件 */
  .storm-prompt {
    border: 1px solid #CFCFCF;
    border-radius: 6px;
    overflow: hidden;
  }
  .storm-prompt-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 8px 14px;
    background: #F2F2F2;
    border-bottom: 1px solid #CFCFCF;
  }
  .storm-prompt-label {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: #4A4A4A;
  }
  .storm-copy-btn {
    flex: none;
    font-size: 12px;
    font-weight: 600;
    padding: 5px 12px;
    border: 1px solid #CFCFCF;
    border-radius: 4px;
    background: #fff;
    color: #4A4A4A;
    cursor: pointer;
    transition: all 0.15s ease;
    white-space: nowrap;
  }
  .storm-copy-btn:hover {
    border-color: #A100FF;
    color: #A100FF;
  }
  .storm-copy-btn[data-copied='1'] {
    border-color: #A100FF;
    background: #A100FF;
    color: #fff;
  }
  .storm-prompt-code {
    margin: 0 !important;
    border-radius: 0 !important;
    padding: 16px 14px;
    background: #1A1A1A;
    color: #F2F2F2;
    font-size: 13px;
    line-height: 1.6;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  .storm-prompt-code code {
    background: transparent !important;
    color: inherit !important;
    padding: 0 !important;
    font-size: inherit;
    white-space: pre;
  }
  @media (max-width: 640px) {
    .storm-prompt-code { font-size: 12px; padding: 12px 10px; }
    .storm-prompt-label { font-size: 11px; }
    .storm-copy-btn { font-size: 11px; padding: 4px 9px; }
  }
</style>

<script>
  // 提示词复制按钮：复制同卡片内 <code> 的纯文本
  document.querySelectorAll('.storm-copy-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const card = btn.closest('.storm-prompt');
      const code = card && card.querySelector('.storm-prompt-code code');
      if (!code) return;
      const text = code.textContent || '';
      const done = () => {
        const prev = btn.textContent;
        btn.textContent = '✓ 已复制';
        btn.setAttribute('data-copied', '1');
        setTimeout(() => {
          btn.textContent = prev;
          btn.removeAttribute('data-copied');
        }, 1800);
      };
      try {
        if (navigator.clipboard && window.isSecureContext) {
          await navigator.clipboard.writeText(text);
        } else {
          // http / 旧浏览器回退
          const ta = document.createElement('textarea');
          ta.value = text;
          ta.setAttribute('readonly', '');
          ta.style.position = 'fixed';
          ta.style.top = '-9999px';
          document.body.appendChild(ta);
          ta.select();
          document.execCommand('copy');
          document.body.removeChild(ta);
        }
        done();
      } catch (e) {
        btn.textContent = '复制失败';
        setTimeout(() => { btn.textContent = '📋 复制'; }, 1800);
      }
    });
  });
</script>
