---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SectionSprite from '../../components/SectionSprite.astro';
import { listReads } from '../../lib/reads';
import '../../styles/sections.css';

const articles = listReads();
const base = import.meta.env.BASE_URL;

// 动态 stat：已收录篇数 / 配播客篇数
const total = articles.length;
const withPodcast = articles.filter((a) => a.audio && a.audio.url).length;

function summaryPreview(summary: string, maxChars = 200): string {
  const text = summary.trim();
  if (text.length <= maxChars) return text;
  return `${text.slice(0, maxChars).replace(/[，。；：、,.!?！？\s]+$/u, '')}…`;
}

// 把「已收录」数字拆成非重音 + 重音两段（末位重音，模仿设计稿 2<i>6</i>）
function splitStat(n: number): { head: string; tail: string } {
  const s = String(n);
  if (s.length <= 1) return { head: '', tail: s };
  return { head: s.slice(0, -1), tail: s.slice(-1) };
}
const totalStat = splitStat(total);
const podStat = splitStat(withPodcast);
---
<Base title="精读室" description="精挑细选的 AI 时代深度好文，配中文解读。">
  <Header />
  <SectionSprite />
  <main class="sec-page" style="--acc:#4F46E5;--acc-deep:#3730A3;--acc-ghost:#EEF0FE;--acc-band:#F7F8FF">
    <section class="hero"><div class="wrap">
      <span class="badge"><svg class="ic"><use href="#i-book"/></svg>Reads</span>
      <h1>精读<span class="pu">室</span></h1>
      <p class="hero-sub">精挑细选的 AI 时代深度好文——中文解读、核心观点、金句精选，可选配双人对谈播客。少而精，宁缺勿滥。</p>
      <div class="stats">
        <div class="stat"><b>{totalStat.head}<i>{totalStat.tail}</i></b><span>已收录</span></div>
        <div class="stat"><b>周<i>更</i></b><span>更新节奏</span></div>
        {withPodcast > 0 && (
          <div class="stat"><b>{podStat.head}<i>{podStat.tail}</i></b><span>配播客</span></div>
        )}
      </div>
    </div></section>

    <div class="wrap">
      <div class="sec-head">
        <span class="sq"><svg class="ic"><use href="#i-book"/></svg></span>
        <div class="tt"><span class="eyebrow">Latest</span><h2>最新精读</h2></div>
        <span class="rule"></span><span class="cnt">{total} 篇</span>
      </div>

      {total === 0 ? (
        <div class="empty"><p>暂无精读文章。</p></div>
      ) : (
        <div class="cards">
          {articles.map((a) => (
            <article class="card">
              <div class="meta">
                <span class="date">{a.savedDate}</span>
                {a.source === 'auto' && <span class="tag">AI 推荐</span>}
                {a.audio && a.audio.url && (
                  <span class="badge-pod"><svg class="ic"><use href="#i-mic"/></svg>播客</span>
                )}
                {a.tags.slice(0, 2).map((t) => <span class="tag">{t}</span>)}
              </div>
              <h3><a href={`${base}reads/${a.slug}/`}>{a.titleZh}</a></h3>
              {a.titleEn && <div class="sub">{a.titleEn}</div>}
              <div class="byline"><b>{a.author}</b>{a.authorTitle && <span> · {a.authorTitle}</span>}</div>
              <p>{summaryPreview(a.summary)}</p>
              <div class="acts">
                <a href={`${base}reads/${a.slug}/`}>进入精读</a>
                {a.originalUrl && <a class="dim" href={a.originalUrl} target="_blank" rel="noopener noreferrer">原文 ↗</a>}
              </div>
            </article>
          ))}
        </div>
      )}
    </div>
  </main>
  <Footer />
</Base>
