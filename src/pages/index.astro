---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import { loadLatest, type NewsItem, type SectionKey } from '../lib/data';
import { allXItems, loadXDate, type XSignalItem } from '../lib/x';

const latest = loadLatest();
if (!latest) return Astro.redirect('/about/');

const base = import.meta.env.BASE_URL;
const xReport = loadXDate(latest.date);
const xItems = xReport ? allXItems(xReport) : [];
const xPreview = xItems.slice(0, 8);
const totalNews = latest.sections.reduce((sum, section) => sum + section.items.length, 0);
const heroBrief = latest.closing?.[0];
const closing = latest.closing?.filter(Boolean) ?? [];

const sectionMeta: Record<SectionKey, { id: string; label: string; icon: string; band: string }> = {
  news: { id: 'news', label: 'AI 热点新闻', icon: 'zap', band: '' },
  enterprise: { id: 'ent', label: '企业级 AI 实践', icon: 'building', band: 'b-lav' },
  coding: { id: 'code', label: 'AI Coding 动态', icon: 'code', band: '' },
  report: { id: 'rep', label: '深度报告与论文', icon: 'chart', band: 'b-warm' },
};

function weekday(date: string) {
  return ['星期日', '星期一', '星期二', '星期三', '星期四', '星期五', '星期六'][new Date(`${date}T12:00:00+08:00`).getDay()];
}

function itemParts(item: NewsItem) {
  const raw = item.title ?? '';
  const withoutEmoji = raw.replace(/^\p{Extended_Pictographic}[\uFE0F\u200D\p{Extended_Pictographic}]*\s*/u, '');
  const split = withoutEmoji.match(/^([^|]{1,16})\s*\|\s*(.+)$/s);
  return split ? { tag: split[1].trim(), title: split[2].trim() } : { tag: '行业动态', title: withoutEmoji.trim() };
}

function tagIcon(tag: string) {
  if (/战略|合作/.test(tag)) return 'handshake';
  if (/融资|资本/.test(tag)) return 'coins';
  if (/市场|数据/.test(tag)) return 'chart';
  if (/产品|发布/.test(tag)) return 'rocket';
  if (/工具|生态/.test(tag)) return 'tool';
  if (/研究|报告|论文|政策/.test(tag)) return 'doc';
  if (/技术|模型/.test(tag)) return 'zap';
  return 'building';
}

function xKindLabel(item: XSignalItem) {
  if (item.kind === 'podcast') return 'PODCAST';
  if (item.kind === 'blog') return 'BLOG';
  return 'POST';
}

function xSource(item: XSignalItem) {
  return item.handle ? `@${item.handle}` : item.sourceName || item.source;
}
---
<Base title={`AI 日报 ${latest.date}`} description={latest.summary}>
  <Header currentDate={latest.date} />

  <svg class="symbol-sprite" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
    <symbol id="i-zap" viewBox="0 0 24 24"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></symbol>
    <symbol id="i-building" viewBox="0 0 24 24"><rect x="4" y="2" width="16" height="20" rx="1"></rect><path d="M9 22v-4h6v4M8 6h.01M16 6h.01M12 6h.01M8 10h.01M16 10h.01M12 10h.01M8 14h.01M16 14h.01M12 14h.01"></path></symbol>
    <symbol id="i-code" viewBox="0 0 24 24"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></symbol>
    <symbol id="i-chart" viewBox="0 0 24 24"><line x1="12" y1="20" x2="12" y2="10"></line><line x1="18" y1="20" x2="18" y2="4"></line><line x1="6" y1="20" x2="6" y2="16"></line></symbol>
    <symbol id="i-radio" viewBox="0 0 24 24"><circle cx="12" cy="12" r="2"></circle><path d="M16.24 7.76a6 6 0 0 1 0 8.49M7.76 16.24a6 6 0 0 1 0-8.49M19.07 4.93a10 10 0 0 1 0 14.14M4.93 19.07a10 10 0 0 1 0-14.14"></path></symbol>
    <symbol id="i-compass" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"></circle><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"></polygon></symbol>
    <symbol id="i-handshake" viewBox="0 0 24 24"><path d="M11 17l-1.5-1.5M14 14l-2 2M8 20l-3-3 7-7 3 3M13 5l7 7-3 3M2 12l5-5 3 3"></path></symbol>
    <symbol id="i-coins" viewBox="0 0 24 24"><circle cx="8" cy="8" r="6"></circle><path d="M18.09 10.37A6 6 0 1 1 10.34 18M7 6h1v4"></path></symbol>
    <symbol id="i-rocket" viewBox="0 0 24 24"><path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09zM12 15l-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"></path></symbol>
    <symbol id="i-tool" viewBox="0 0 24 24"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path></symbol>
    <symbol id="i-doc" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></symbol>
    <symbol id="i-ext" viewBox="0 0 24 24"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></symbol>
    <symbol id="i-arrow" viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="13 6 19 12 13 18"></polyline></symbol>
    <symbol id="i-chevron-down" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"></polyline></symbol>
    <symbol id="i-chevron-up" viewBox="0 0 24 24"><polyline points="18 15 12 9 6 15"></polyline></symbol>
  </svg>

  <main class="home-v13">
    <section class="hero">
      <div class="wrap hero-in">
        <div class="date-line">{latest.date} · {weekday(latest.date)} · 每日 08:18 更新</div>
        <h1>AI 情报，<span>一页读完</span></h1>
        <p class="hero-sub">{totalNews} 条今日日报{xReport ? ` + ${xItems.length} 条 X 信号` : ''}，中文提炼，无需跳转。</p>
        {heroBrief && <div class="hero-brief"><b>今日观点</b>{heroBrief}</div>}
        <nav class="chips" aria-label="本期内容导航">
          {latest.sections.map((section) => {
            const meta = sectionMeta[section.key];
            return <a class="chip" href={`#${meta.id}`}><svg class="ic"><use href={`#i-${meta.icon}`}></use></svg>{meta.label.replace(/^AI /, '')}<span class="n">{section.items.length}</span></a>;
          })}
          {xReport && <a class="chip sig" href="#xzone"><svg class="ic"><use href="#i-radio"></use></svg>X<span class="n">{xItems.length}</span></a>}
        </nav>
      </div>
    </section>

    {latest.sections.map((section) => {
      const meta = sectionMeta[section.key];
      return (
        <section class={`band ${meta.band}`} id={meta.id}>
          <div class="wrap">
            <div class="sec-head">
              <span class="sq"><svg class="ic"><use href={`#i-${meta.icon}`}></use></svg></span>
              <h2>{meta.label}</h2><span class="cnt">{section.items.length} 条</span>
            </div>
            <div class="cards">
              {section.items.map((item, index) => {
                const parts = itemParts(item);
                return (
                  <article class={`card ${index === 0 ? 'lead' : ''}`}>
                    <div class="tag-row"><span class="pill"><svg class="ic"><use href={`#i-${tagIcon(parts.tag)}`}></use></svg>{parts.tag}</span><span class="src">{item.source || '来源待补充'}</span></div>
                    <h3>{item.url ? <a href={item.url} target="_blank" rel="noreferrer">{parts.title}</a> : parts.title}</h3>
                    <p class="body">{item.body}</p>
                    {item.insight && <div class="insight"><b>洞察</b><span class="middot">·</span>{item.insight}</div>}
                    <div class="card-foot">
                      <button class="more-btn" type="button" aria-expanded="false"><span>展开全文</span><svg class="ic toggle-icon"><use href="#i-chevron-down"></use></svg></button>
                      <a class="orig" href={item.url || `${base}about/`} target="_blank" rel="noreferrer">阅读原文<svg class="ic"><use href="#i-ext"></use></svg></a>
                    </div>
                  </article>
                );
              })}
            </div>
          </div>
        </section>
      );
    })}

    {xReport && xPreview.length > 0 && (
      <section class="band b-pink" id="xzone">
        <div class="wrap">
          <div class="sec-head">
            <span class="sq"><svg class="ic"><use href="#i-radio"></use></svg></span>
            <h2>X</h2><span class="cnt">{xItems.length} 条</span>
          </div>
          <div class="cards">
            {xPreview.map((item) => (
              <article class="card x-card">
                <div class="tag-row"><span class="pill"><svg class="ic"><use href="#i-radio"></use></svg>{xKindLabel(item)}</span><span class="src">{xSource(item)}</span></div>
                <h3><a href={item.url} target="_blank" rel="noreferrer">{item.title}</a></h3>
                <p class="body body-zh">{item.insightZh}</p>
                {item.summaryEn && <p class="body body-en" lang="en">{item.summaryEn}</p>}
                <div class="card-foot">
                  <button class="more-btn" type="button" aria-expanded="false"><span>展开全文</span><svg class="ic toggle-icon"><use href="#i-chevron-down"></use></svg></button>
                  <a class="orig" href={item.url || `${base}x/`} target="_blank" rel="noreferrer">阅读原文<svg class="ic"><use href="#i-ext"></use></svg></a>
                </div>
              </article>
            ))}
          </div>
          <div class="x-more"><a href={`${base}x/`}>查看全部 {xItems.length} 条<svg class="ic"><use href="#i-arrow"></use></svg></a></div>
        </div>
      </section>
    )}

    {closing.length > 0 && (
      <div class="wrap">
        <section class="closing">
          <h2><svg class="ic"><use href="#i-compass"></use></svg>收盘点评</h2>
          {closing.map((paragraph) => <p>{paragraph}</p>)}
        </section>
      </div>
    )}
  </main>

  <footer class="home-footer">aidigest.club · AI 日报与 Builder Intelligence</footer>
</Base>

<script is:inline>
  document.querySelectorAll('.home-v13 .more-btn').forEach((button) => {
    button.addEventListener('click', () => {
      const card = button.closest('.card');
      if (!card) return;
      const expanded = card.classList.toggle('expand');
      button.setAttribute('aria-expanded', String(expanded));
      const label = button.querySelector('span');
      const use = button.querySelector('use');
      if (label) label.textContent = expanded ? '收起' : '展开全文';
      if (use) use.setAttribute('href', expanded ? '#i-chevron-up' : '#i-chevron-down');
    });
  });
</script>

<style>
  :global(body){background:#fff;color:#17171c}
  .symbol-sprite{position:absolute;width:0;height:0;overflow:hidden}
  .home-v13{--purple:#A100FF;--purple-deep:#7500C0;--purple-ghost:#F7EDFF;--pink-tint:#FDF4FB;--lav-tint:#F8F6FE;--warm-tint:#FBF7F3;--ink:#000;--gray-7:#3b3b42;--gray-5:#696973;--gray-4:#9d9daa;--gray-2:#e8e8ee;--gray-1:#f4f4f7;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","PingFang SC","Noto Sans SC",sans-serif;line-height:1.65;-webkit-font-smoothing:antialiased}
  .home-v13 *{box-sizing:border-box}
  .wrap{max-width:1080px;margin:0 auto;padding:0 16px}
  .ic{width:1em;height:1em;stroke:currentColor;stroke-width:2;fill:none;stroke-linecap:round;stroke-linejoin:round;vertical-align:-.12em;flex:none}
  .hero{position:relative;background:radial-gradient(ellipse 100% 80% at 88% -20%,rgba(161,0,255,.055),transparent 60%),radial-gradient(ellipse 80% 70% at 5% 115%,rgba(240,171,224,.07),transparent 62%),#fff;border-bottom:1px solid var(--gray-2);padding:34px 0 0;overflow:hidden}
  .date-line{font-size:12.5px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--gray-5);margin-bottom:14px}
  .hero h1{margin:0;font-size:clamp(28px,6.5vw,46px);font-weight:800;letter-spacing:-.035em;line-height:1.15;color:var(--ink)}
  .hero h1 span{color:var(--purple)}
  .hero-sub{color:var(--gray-5);font-size:14.5px;margin:12px 0 0;max-width:560px}
  .hero-brief{margin-top:16px;max-width:760px;background:rgba(255,255,255,.75);backdrop-filter:blur(4px);border:1px solid #eeddfb;border-left:3px solid var(--purple);border-radius:4px;padding:13px 16px;font-size:13.5px;color:var(--gray-7);line-height:1.7}
  .hero-brief b{color:var(--purple-deep);font-weight:800;letter-spacing:.03em;margin-right:6px}
  .chips{display:flex;gap:8px;margin-top:24px;overflow-x:auto;padding-bottom:18px;scrollbar-width:none}
  .chips::-webkit-scrollbar{display:none}
  .chip{flex:none;display:inline-flex;align-items:center;gap:7px;font-size:12.5px;font-weight:700;color:var(--gray-7);background:rgba(255,255,255,.8);border:1.5px solid var(--gray-2);padding:8px 15px;border-radius:3px;transition:.15s}
  .chip:hover{border-color:var(--purple);color:var(--purple-deep)}
  .chip .ic{font-size:14px;color:var(--purple)}.chip .n{font-size:11px;color:var(--gray-4)}.chip.sig{border-color:#e9d5ff;background:linear-gradient(135deg,var(--purple-ghost),#fff)}
  .band{padding:6px 0 26px;position:relative;scroll-margin-top:68px}.b-lav{background:var(--lav-tint)}.b-warm{background:var(--warm-tint)}.b-pink{background:var(--pink-tint)}
  .sec-head{display:flex;align-items:center;gap:11px;margin:30px 0 16px}.sec-head .sq{width:34px;height:34px;border-radius:3px;display:flex;align-items:center;justify-content:center;background:var(--purple-ghost);color:var(--purple-deep);font-size:16px;flex:none}.sec-head h2{margin:0;font-size:19px;font-weight:800;letter-spacing:-.02em;color:var(--ink)}.sec-head .cnt{margin-left:auto;font-size:11.5px;color:var(--gray-4);font-weight:700;letter-spacing:.06em}
  .cards{display:grid;grid-template-columns:1fr;gap:12px}
  .card{background:#fff;border:1px solid var(--gray-2);border-radius:6px;padding:18px 18px 14px;position:relative;transition:.16s;overflow:hidden;display:flex;flex-direction:column;min-width:0}
  .card:before{content:"";position:absolute;left:0;top:0;bottom:0;width:3px;background:transparent;transition:.16s}.card:hover{border-color:#d5c0ea;box-shadow:0 6px 24px rgba(117,0,192,.07);transform:translateY(-2px)}.card:hover:before{background:var(--purple)}
  .card.lead{border-top:3px solid var(--purple)}.card.lead:before{display:none}
  .tag-row{display:flex;align-items:center;gap:8px;margin-bottom:9px;min-width:0}.pill{display:inline-flex;align-items:center;gap:5px;font-size:11px;font-weight:800;letter-spacing:.04em;padding:3px 9px;border-radius:3px;background:var(--purple-ghost);color:var(--purple-deep);white-space:nowrap}.pill .ic{font-size:11px}.src{font-size:11.5px;color:var(--gray-4);margin-left:auto;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .card h3{font-size:15.5px;font-weight:750;line-height:1.45;letter-spacing:-.01em;margin:0 0 8px;color:var(--ink)}.card h3 a:hover{color:var(--purple-deep)}
  .card p.body{margin:0;font-size:13.5px;color:var(--gray-7);display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}.card.expand p.body{-webkit-line-clamp:unset;display:block}.x-card .body-en{display:none;margin-top:10px;color:var(--gray-5)}.x-card.expand .body-en{display:block}
  .insight{margin-top:11px;padding:9px 13px;background:var(--gray-1);border-left:3px solid var(--purple);font-size:12.5px;color:var(--gray-7)}.insight b{color:var(--purple-deep);font-weight:800;letter-spacing:.03em}.middot{margin:0 5px}
  .card-foot{display:flex;align-items:center;margin-top:auto;padding-top:11px}.more-btn{display:inline-flex;align-items:center;gap:4px;font-size:12px;color:var(--gray-5);font-weight:700;background:none;border:0;cursor:pointer;padding:0}.more-btn:hover{color:var(--purple-deep)}.toggle-icon{font-size:12px}.orig{margin-left:auto;display:inline-flex;align-items:center;gap:5px;font-size:12px;font-weight:700;color:var(--purple-deep)}.orig:hover{text-decoration:underline}.orig .ic{font-size:12px}
  .x-more{display:flex;justify-content:center;margin-top:18px}.x-more a{display:inline-flex;align-items:center;gap:9px;color:#fff;font-size:13.5px;font-weight:800;background:var(--purple);padding:12px 26px;border-radius:3px;transition:.15s}.x-more a:hover{background:var(--purple-deep)}
  .closing{margin:38px 0 8px;background:#fff;border:1px solid var(--gray-2);border-top:3px solid var(--ink);border-radius:6px;padding:22px 20px}.closing h2{display:flex;align-items:center;gap:9px;font-size:15px;font-weight:800;margin:0 0 10px;color:var(--ink)}.closing h2 .ic{color:var(--purple)}.closing p{font-size:13.5px;color:var(--gray-7);margin:0 0 8px}.closing p:last-child{margin-bottom:0}
  .home-footer{margin-top:38px;padding:28px 16px 42px;text-align:center;color:#9d9daa;font-size:12px;border-top:1px solid #e8e8ee}
  @media(min-width:768px){.cards{grid-template-columns:1fr 1fr;gap:16px}.card.lead{grid-column:1/-1}}
  @media(max-width:480px){.hero{padding-top:26px}.hero-brief{font-size:13px}.card{padding:16px 15px 13px}.sec-head{margin-top:25px}.src{max-width:52%}}
</style>
