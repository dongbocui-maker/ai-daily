---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SectionSprite from '../components/SectionSprite.astro';
import '../styles/sections.css';
---
<Base title="关于" description="关于 aidigest.club —— 一个 AI 辅助整理、自动 + 人工混合更新的 AI 行业信息聚合站。">
  <Header />
  <SectionSprite />
  <main class="sec-page about-page" style="--acc:#A100FF;--acc-deep:#7500C0;--acc-ghost:#F7EDFF;--acc-band:#FBF8FF">
    <section class="hero"><div class="wrap">
      <span class="badge"><svg class="ic"><use href="#i-doc"/></svg>About</span>
      <h1>关于<span class="pu">本站</span></h1>
      <p class="hero-sub">一个 AI 辅助整理、自动 + 人工混合更新的 AI 行业信息聚合站。</p>
      <div class="stats">
        <div class="stat"><b>6<i></i></b><span>独立栏目</span></div>
        <div class="stat"><b>每<i>日</i></b><span>清晨更新</span></div>
        <div class="stat"><b>AI+<i>人工</i></b><span>混合生成</span></div>
      </div>
    </div></section>

    <div class="wrap">

      {/* ===== 内容范围 ===== */}
      <div class="sec-head">
        <span class="sq"><svg class="ic"><use href="#i-cal"/></svg></span>
        <div class="tt"><span class="eyebrow">Coverage</span><h2>内容范围</h2></div>
        <span class="rule"></span>
      </div>
      <p class="lead">本站由 <strong>6 个独立栏目</strong> + <strong>每日新闻 4 板块</strong> 组成。每个栏目有不同的更新节奏和信息源。</p>

      <div class="col-list">
        <div class="col-item">
          <h3>情报流 · 档案库<span class="en">Feed · Vault</span></h3>
          <p>每日清晨自动同步过去 24 小时全球 AI 行业重要动态，按 4 个板块组织：<strong>AI 热点新闻</strong>（重大融资、产品发布、监管动态、突发事件）· <strong>企业级 AI 实践</strong>（落地案例、Agent 编排、企业架构演进）· <strong>AI Coding 动态</strong>（编码模型、IDE 集成、开发者工具）· <strong>深度报告与论文</strong>（行业研究、学术论文、白皮书）。往期按月归入档案库可回溯。</p>
        </div>
        <div class="col-item">
          <h3>开源榜<span class="en">GH Trends</span></h3>
          <p>同步 GitHub Trending 上 AI 相关仓库的热度变化、Star 增长、新晋黑马项目，聚焦开源生态。提供本周 / 本月 / 年度项目 / 历史热门四档榜单，每档含综合榜与 AI 专题双维度，跨周期对比排名变化。</p>
        </div>
        <div class="col-item">
          <h3>X · Builder Signals<span class="en">Builder Intelligence</span></h3>
          <p>从全球 AI builders / founders / researchers 的 X、播客、博客中提炼高信号观点，形成中文可读的 Builder Intelligence。每日清晨自动抓取、精选、翻译，呈现当日最值得关注的一手从业者视角。</p>
        </div>
        <div class="col-item">
          <h3>竞技场<span class="en">Arena</span></h3>
          <p>基于 <a href="https://arena.ai/leaderboard" target="_blank" rel="noopener">LMArena / arena.ai</a> 真实人类盲测对战数据的全球大模型 Top 50 排行榜。每月 1 日 10:30 自动抓取、解析、生成优势赛道标签，与上月快照对比生成排名变化（↑ / ↓ / 新入榜 / 退榜）。</p>
        </div>
        <div class="col-item">
          <h3>精读室<span class="en">Reads</span></h3>
          <p>精挑细选的 AI 时代深度长文，配中文解读、核心观点、金句精选，并可为每篇生成<strong>中文双主持播客音频</strong>（NotebookLM 驱动，可边听边读）。每周日 09:00 自动生成候选清单（3-5 篇），人工拍板后写正式精读卡片。<strong>宁缺勿滥</strong>——某周无合适候选则跳过，不为凑数硬塞。</p>
        </div>
        <div class="col-item">
          <h3>研修院<span class="en">Academy</span></h3>
          <p>AI 相关的学习计划、课程笔记、技术资料汇总。独立于每日资讯主题，更聚焦于深度学习和长期价值。手工维护，按需更新。</p>
        </div>
      </div>

      {/* ===== 信息源 ===== */}
      <div class="sec-head">
        <span class="sq"><svg class="ic"><use href="#i-doc"/></svg></span>
        <div class="tt"><span class="eyebrow">Sources</span><h2>信息源</h2></div>
        <span class="rule"></span>
      </div>
      <p class="lead">本站每日新闻栏目的权威信息源，按类别划分：</p>

      <div class="src-block">
        <h4>国际媒体</h4>
        <ul class="src-grid">
          <li>Reuters</li><li>Bloomberg</li><li>FT</li>
          <li>WSJ</li><li>NYT</li><li>The Guardian</li>
          <li>The Information</li><li>Wired</li><li>TechCrunch</li>
          <li>The Verge</li><li>VentureBeat</li><li>Ars Technica</li>
        </ul>
      </div>

      <div class="src-block">
        <h4>国际独立深度源</h4>
        <p class="src-note">权威性高 / 一手深度 / 推荐优先引用（2026-05 起纳入日报每日源，不仅供精读使用）</p>
        <ul class="src-grid">
          <li>Latent.Space (swyx)</li><li>Interconnects (Nathan Lambert)</li><li>Stratechery (Ben Thompson)</li>
          <li>SemiAnalysis (Dylan Patel)</li><li>One Useful Thing (Ethan Mollick)</li><li>Import AI (Jack Clark)</li>
          <li>The Zvi (Zvi Mowshowitz)</li>
        </ul>
      </div>

      <div class="src-block">
        <h4>厂商一手源</h4>
        <ul class="src-grid">
          <li>OpenAI</li><li>Anthropic</li><li>Google DeepMind</li>
          <li>Google Keyword Blog</li><li>Microsoft</li><li>Meta</li>
          <li>NVIDIA</li><li>arXiv</li><li>GitHub Trending</li>
        </ul>
      </div>

      <div class="src-block">
        <h4>业界 Newsletter / 人工选题信号源</h4>
        <p class="src-note">提供当日人工编辑选题背书，助于筛选热点；只作软信号，不直接引用</p>
        <ul class="src-grid">
          <li>Hacker News (AI)</li><li>Smol AI News</li><li>The AI Valley</li>
          <li>Every</li>
        </ul>
      </div>

      <div class="src-block">
        <h4>中文科技媒体</h4>
        <ul class="src-grid">
          <li>36氪</li><li>机器之心</li><li>量子位</li>
          <li>虎嗅</li><li>晚点 LatePost</li><li>极客公园</li>
          <li>InfoQ 中国</li><li>雷峰网</li><li>PingWest 品玩</li>
          <li>钛媒体</li><li>IT 之家</li><li>智东西</li>
          <li>36氪出海</li><li>华尔街见闻</li><li>硅星人 GenAI</li>
          <li>甲子光年</li>
        </ul>
      </div>

      <div class="src-block">
        <h4>咨询与研究机构</h4>
        <ul class="src-grid">
          <li>Accenture</li><li>McKinsey</li><li>BCG</li>
          <li>Gartner</li><li>IDC</li><li>Deloitte</li>
          <li>PwC</li><li>Stanford HAI</li><li>MIT Technology Review</li>
          <li>OECD.AI</li><li>Brookings AIET</li><li>中国信通院 CAICT</li>
        </ul>
      </div>

      <div class="src-block">
        <h4>投融资 / 并购专源</h4>
        <ul class="src-grid">
          <li>Crunchbase News</li><li>Sifted（欧洲）</li><li>投中网（国内）</li>
        </ul>
      </div>

      {/* ===== 精读专用信息源 ===== */}
      <div class="sec-head">
        <span class="sq"><svg class="ic"><use href="#i-book"/></svg></span>
        <div class="tt"><span class="eyebrow">Deep Reads Sources</span><h2>精读专用信息源</h2></div>
        <span class="rule"></span>
      </div>
      <p class="lead">「精读室」栏目面向深度长文（原创洞察、深度分析、长期价值）。除上述日报源（含「国际独立深度源」如 Stratechery / Latent.Space / Import AI / The Zvi 等）也可作为精读候选外，额外依赖以下季度大报告与播客 / 学术 / 政策深度来源：</p>

      <div class="src-block">
        <h4>厂商研究 / 顶级博客</h4>
        <ul class="src-grid">
          <li>Anthropic Research</li><li>Anthropic Transformer Circuits</li><li>OpenAI Research</li>
          <li>Google Research</li><li>Microsoft Research</li><li>Andrej Karpathy Blog</li>
        </ul>
      </div>

      <div class="src-block">
        <h4>深度播客 / Newsletter</h4>
        <ul class="src-grid">
          <li>Dwarkesh Podcast</li><li>Ben's Bites Pro</li><li>Andrew Ng — The Batch</li>
          <li>Lenny's Newsletter</li><li>Exponential View (Azeem Azhar)</li><li>ChinAI (Jeffrey Ding)</li>
        </ul>
      </div>

      <div class="src-block">
        <h4>学术 / 政策</h4>
        <ul class="src-grid">
          <li>Stanford HAI</li><li>MIT Technology Review 长文</li><li>OECD.AI</li>
          <li>Brookings AIET</li>
        </ul>
      </div>

      <div class="src-block">
        <h4>中文研究院与深度媒体</h4>
        <p class="src-note">政策 / 伦理 / 产业季度大报告与深度长文解读，专供精读使用，不入日报</p>
        <ul class="src-grid">
          <li>腾讯研究院 (tisi.org)</li><li>未尽研究 (启明创投合作)</li><li>新智元</li>
          <li>阿里研究院 (aliresearch.com)<span class="obs">（观察期）</span></li>
        </ul>
      </div>

      {/* ===== 类型标签 ===== */}
      <div class="sec-head">
        <span class="sq"><svg class="ic"><use href="#i-star"/></svg></span>
        <div class="tt"><span class="eyebrow">Tags</span><h2>类型标签</h2></div>
        <span class="rule"></span>
      </div>
      <p class="lead">「AI 热点新闻」板块覆盖话题较广，每条新闻开头会附一个类型标签便于快速浏览：</p>
      <div class="chips-row" style="margin-top:14px">
        <span class="org-chip">收并购</span><span class="org-chip">融资</span><span class="org-chip">产品发布</span>
        <span class="org-chip">监管政策</span><span class="org-chip">高层动态</span><span class="org-chip">技术突破</span>
        <span class="org-chip">行业动向</span>
      </div>

      {/* ===== 生成机制 ===== */}
      <div class="sec-head">
        <span class="sq"><svg class="ic"><use href="#i-cal"/></svg></span>
        <div class="tt"><span class="eyebrow">Pipeline</span><h2>生成机制</h2></div>
        <span class="rule"></span>
      </div>
      <p class="lead">本站 6 个栏目使用混合更新策略：</p>

      <div class="mech-table">
        <table>
          <thead>
            <tr><th>栏目</th><th>更新节奏</th><th>触发方式</th></tr>
          </thead>
          <tbody>
            <tr><td><strong>情报流 · 档案库</strong></td><td>每日 06:18 (Asia/Shanghai)</td><td>全自动 (AI Agent + cron)</td></tr>
            <tr><td><strong>开源榜</strong></td><td>周榜每周一 / 月榜每月 1 日 / 年榜每周一</td><td>全自动 (GitHub Actions + 本地 cron)</td></tr>
            <tr><td><strong>X · Builder Signals</strong></td><td>每日 07:00 (Asia/Shanghai)</td><td>全自动 (AI Agent + cron)</td></tr>
            <tr><td><strong>竞技场</strong></td><td>每月 1 日 10:30</td><td>全自动 (system cron + mihomo 抓取)</td></tr>
            <tr><td><strong>精读室</strong></td><td>每周日 09:00 候选 + 不定期上线</td><td>半自动 (AI 筛候选 → 人工拍板 → 写卡片 + 中文播客音频)</td></tr>
            <tr><td><strong>研修院</strong></td><td>按需更新</td><td>全人工</td></tr>
          </tbody>
        </table>
      </div>

      <div class="panel">
        <h3>每日新闻流程</h3>
        <ol style="margin:6px 0 0 20px">
          <li>清晨 06:13 预采集脚本并行抓 7 份热度信号（Hacker News · Smol AI · TC/Verge/Ars · 量子位/36氪 · blog.google · Every · The AI Valley）</li>
          <li>06:18 AI Agent 读取信号文件 + 联网补充搜索过去 24 小时各信息源最新内容</li>
          <li>按四个板块筛选、整合、撰写要点与行业启示；信号源多重重叠的事件优先纳入</li>
          <li>每条热点新闻自动打上类型标签</li>
          <li>同步到本站 + 飞书工作文档</li>
          <li>GitHub Actions 自动部署、公开访问</li>
        </ol>
      </div>

      {/* ===== 免责声明 ===== */}
      <div class="sec-head">
        <span class="sq"><svg class="ic"><use href="#i-doc"/></svg></span>
        <div class="tt"><span class="eyebrow">Disclaimer</span><h2>免责声明</h2></div>
        <span class="rule"></span>
      </div>
      <div class="disclaimer">
        <p><strong>个人项目声明</strong> · 本站为个人学习项目，与任何机构无关联，亦不代表任何机构观点。视觉风格灵感来源于企业咨询行业的设计语言，但不使用任何机构的官方品牌资产。</p>
        <p><strong>内容免责</strong> · 内容由 AI 辅助整理生成，可能存在事实偏差或时效问题。所有内容仅供参考，不构成投资、决策或咨询建议。请以原始信息源为准。</p>
        <p><strong>版权声明</strong> · 所有引用的新闻、报告内容版权归原作者所有，本站仅作摘要与链接。</p>
      </div>

      <div style="height:56px"></div>
    </div>
  </main>
  <Footer />
</Base>

<style>
  /* about 页专属排版——沿用 sections.css 的 --acc 令牌，无 emoji */
  .about-page .lead { font-size: 14.5px; color: var(--gray-7); line-height: 1.75; margin: 0 0 6px; max-width: 760px; }
  .about-page .lead strong { color: var(--ink); font-weight: 750; }

  /* 栏目介绍列表 */
  .about-page .col-list { display: flex; flex-direction: column; gap: 12px; margin-top: 18px; }
  .about-page .col-item {
    background: #fff; border: 1px solid var(--gray-2); border-left: 3px solid var(--acc);
    border-radius: 6px; padding: 16px 18px;
  }
  .about-page .col-item h3 {
    margin: 0 0 7px; font-size: 15.5px; font-weight: 800; letter-spacing: -.01em; color: var(--ink);
    display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap;
  }
  .about-page .col-item h3 .en {
    font-size: 10.5px; font-weight: 850; letter-spacing: .18em; text-transform: uppercase; color: var(--acc);
  }
  .about-page .col-item p { margin: 0; font-size: 13px; color: var(--gray-5); line-height: 1.75; }
  .about-page .col-item p strong { color: var(--gray-7); font-weight: 750; }
  .about-page .col-item a { color: var(--acc-deep); text-decoration: underline; }

  /* 信息源块 */
  .about-page .src-block { margin-top: 22px; }
  .about-page .src-block h4 {
    margin: 0 0 4px; font-size: 12px; font-weight: 850; letter-spacing: .1em; text-transform: uppercase;
    color: var(--acc-deep);
  }
  .about-page .src-note { font-size: 11.5px; color: var(--gray-4); margin: 0 0 10px; line-height: 1.6; }
  .about-page .src-grid {
    list-style: none; margin: 8px 0 0; padding: 0;
    display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 7px 14px;
  }
  .about-page .src-grid li {
    font-size: 12.5px; color: var(--gray-7); padding-left: 13px; position: relative; line-height: 1.5;
  }
  .about-page .src-grid li::before {
    content: ""; position: absolute; left: 0; top: 8px; width: 4px; height: 4px; border-radius: 50%;
    background: var(--acc); opacity: .55;
  }
  .about-page .src-grid .obs { color: var(--gray-4); font-size: 11px; }

  /* 生成机制表格 */
  .about-page .mech-table { overflow-x: auto; margin-top: 16px; }
  .about-page .mech-table table {
    width: 100%; border-collapse: collapse; font-size: 12.5px;
    border: 1px solid var(--gray-2); border-radius: 6px; overflow: hidden;
  }
  .about-page .mech-table th {
    text-align: left; font-weight: 800; font-size: 11px; letter-spacing: .06em; text-transform: uppercase;
    color: var(--gray-5); background: var(--acc-band); padding: 10px 14px; border-bottom: 1px solid var(--gray-2);
  }
  .about-page .mech-table td { padding: 10px 14px; border-bottom: 1px solid var(--gray-1); color: var(--gray-7); vertical-align: top; }
  .about-page .mech-table tbody tr:last-child td { border-bottom: 0; }
  .about-page .mech-table td strong { color: var(--ink); font-weight: 750; }
  .about-page .panel ol { color: var(--gray-7); }
  .about-page .panel li { margin-bottom: 4px; }

  /* 免责声明 */
  .about-page .disclaimer {
    background: var(--acc-band); border: 1px solid var(--gray-2); border-left: 4px solid var(--acc);
    border-radius: 6px; padding: 18px 20px; margin-top: 16px;
  }
  .about-page .disclaimer p { font-size: 13px; color: var(--gray-7); line-height: 1.75; margin: 0 0 10px; }
  .about-page .disclaimer p:last-child { margin-bottom: 0; }
  .about-page .disclaimer strong { color: var(--ink); font-weight: 750; }
</style>
